---
import { site, footer } from "../data/content.js";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {year} {site.title}</p>
    {footer.note && <p class="footer-note">{footer.note}</p>}
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
</style>
