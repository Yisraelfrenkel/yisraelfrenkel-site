---
// "The Sefer edition": an alternative homepage built strictly along the
// design-taste-frontend direction sheet (seed 629202508, "The page is the
// object", olive on bone, Gambarino / General Sans). Kept at /sefer so it
// can be compared with the live homepage. Copy comes from home.js.
import Layout from "../layouts/Layout.astro";
import { site } from "../data/content.js";
import { doors, homeHero } from "../data/home.js";

const book = site.personalSessionUrl;
const wa = site.personalWhatsappUrl;
const mail = `mailto:${site.email}`;
const href = (t) => t.href ?? `/topics/${t.slug}`;
const year = new Date().getFullYear();

// One picture per chapter for the index preview.
const plates = {
  "young-women": "/images/painting-build.jpg",
  "young-men": "/images/painting-listen.jpg",
  "marriage-course": "/images/yisrael-teaching-conversation.jpg",
  "or-hazivug": "/images/painting-fulfill.jpg",
  "beauty-of-human-desire": "/images/painting-tikkun-habris.jpeg",
  ayeka: "/images/yisrael-vineyard-portrait.jpg",
  addiction: "/images/path-from-shame-to-fulfillment.jpg",
  trauma: "/images/painting-heal.jpg",
  "abuse-in-the-community": "/images/chaburah-in-person.jpg",
  "healing-emunah": "/images/painting-discern.jpg",
  "torah-and-geula": "/images/yisrael-study-desk.jpg",
};

// The live thing: what the visitor is carrying, and the chapter it points to.
const carrying = [
  { label: "I'm getting married", target: "door-1" },
  { label: "I keep falling", target: "beauty-of-human-desire" },
  { label: "Something from the past still hurts", target: "trauma" },
  { label: "I don't know what I'm here for", target: "ayeka" },
];
---

<Layout
  title="Yisrael Frenkel — Torah and psychology, one human being"
  description="A beis medrash of classes, courses and private sessions with Rav Yisrael Frenkel: marriage, desire, healing, faith and Torah."
  bodyClass="sefer"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=gambarino@400&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500&display=swap" rel="stylesheet" />
  </Fragment>

  <a class="skip" href="#contents">Skip to the contents</a>

  <header class="bar">
    <a class="bar__mark" href="/sefer">Yisrael Frenkel</a>
    <nav class="bar__links" aria-label="Main">
      <a href="#contents">Contents</a>
      <a href="/about">About</a>
      <a href="/beauty-of-human-desire">Free class</a>
    </nav>
    <a class="button button--paper" href={book}>Book a private session</a>
  </header>

  <main>
    <!-- The title page -->
    <section class="shaar">
      <div class="shaar__page" data-in>
        <div class="shaar__arch" aria-hidden="true"><div></div></div>
        <div class="shaar__text" data-in>
          <p class="shaar__he" lang="he" dir="rtl">בית מדרש</p>
          <h1>Yisrael Frenkel</h1>
          <p class="shaar__lead">Torah and psychology, one human being.</p>
          <p class="shaar__sub">Classes, courses and private sessions, from Yerushalayim.</p>
          <a class="button" href={book}>Book a private session</a>
          <p class="shaar__write">Prefer to write? <a href={wa}>WhatsApp</a> or <a href={mail}>email</a>.</p>
          <p class="shaar__he shaar__he--small" lang="he" dir="rtl">ובו ארבעה שערים</p>
          <ul class="shaar__gates">
            {doors.map((d) => (<li><a href={`#${d.id}`}>{d.name}</a></li>))}
          </ul>
        </div>
        <p class="shaar__imprint">Maggid shiur at the Mir and at Bat Ayin · Rav musmach · Rav of Kehilat Chaverim</p>
      </div>
      <nav class="tabs" aria-label="The four gates" data-in>
        {doors.map((d) => (
          <a class="tab" href={`#${d.id}`}>{d.name}</a>
        ))}
      </nav>
    </section>

    <!-- The table of contents -->
    <section class="contents" id="contents">
      <div class="contents__head" data-in>
        <h2>Four gates.<br />Eleven chapters.</h2>
        <p>
          Marriage, desire, healing and faith are not separate subjects. They are one human life, so this beis
          medrash is written as one sefer. Start with the chapter closest to what you are carrying now.
        </p>
        <div class="carrying" id="carrying">
          <p>What are you carrying?</p>
          <div class="carrying__row">
            {carrying.map((c) => (
              <a class="button button--line" href={`#${c.target}`} data-target={c.target}>{c.label}</a>
            ))}
          </div>
        </div>
      </div>

      <div class="index">
        <div class="index__list">
          {doors.map((d) => (
            <section class="gate" id={d.id}>
              <img class="gate__plate" src={d.image} alt={d.imageAlt} width="1200" height="900" loading="lazy" />
              <h3>{d.name}</h3>
              <p class="gate__lead">{d.lead}</p>
              <ul>
                {d.topics.map((t) => (
                  <li>
                    <a class="index__row" href={href(t)} id={t.slug} data-preview={plates[t.slug]}>
                      <img class="index__thumb" src={plates[t.slug]} alt="" loading="lazy" width="640" height="480" />
                      <span class="index__name">{t.title}</span>
                      <span class="index__dots" aria-hidden="true"></span>
                      <span class="index__status">{t.href ? "open" : "soon"}</span>
                      <span class="index__text">{t.subtitle && <i>{t.subtitle} · </i>}{t.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <div class="index__frame" aria-hidden="true"><img src="/images/painting-build.jpg" alt="" width="640" height="480" /></div>
      </div>
    </section>

    <!-- The founder's letter -->
    <section class="letter">
      <div class="sheet" data-in>
        <img class="sheet__portrait" src="/images/yisrael-blue-jacket.jpg" alt="" width="88" height="88" loading="lazy" />
        <h2 class="visually-hidden">A letter from Yisrael</h2>
        <p>
          They are two windows onto the same human reality. I'm Rav Yisrael Frenkel, and for more than twenty years
          people have trusted me with what they can't say out loud to anyone else.
        </p>
        <p>
          Torah and psychology are not two disciplines I try to combine. They are two windows looking at the same
          person, and each helps us see what the other has been showing us all along.
        </p>
        <p>
          Marriage, desire, healing and faith are not separate subjects. They are one human life. That is why I
          teach them as one body of ideas, and why the contents above read the way they do.
        </p>
        <p>
          Start with the chapter closest to what you are carrying now. Or write to me, and we will find it
          together.
        </p>
        <p class="sheet__sign">Yisrael Frenkel</p>
        <p class="sheet__role">{homeHero.credentials}</p>
      </div>
      <svg class="scallops scallops--down" viewBox="0 0 640 24" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 0h640v0c0 0-20 24-40 24s-40-24-40-24-20 24-40 24-40-24-40-24-20 24-40 24-40-24-40-24-20 24-40 24-40-24-40-24-20 24-40 24-40-24-40-24-20 24-40 24-40-24-40-24-20 24-40 24-40-24-40-24-20 24-40 24-40-24-40-24z" />
      </svg>
      <div class="perforation" aria-hidden="true"></div>
      <a class="stub" href={mail} data-in>
        <span>Write to me</span>
        <span>{site.email}</span>
      </a>
    </section>

    <!-- The reply card -->
    <section class="reply">
      <p class="reply__aside" data-in>Tell me what you're carrying, and we'll find the right place to start together.</p>
      <div class="card" data-in>
        <h2>Not sure where to begin?</h2>
        <p>One conversation, in person in Yerushalayim or online. No one is turned away.</p>
        <a class="button button--bar" href={book}>Book a private session</a>
        <p class="card__alt"><a href={wa}>WhatsApp</a> · <a href={mail}>Email</a></p>
      </div>
    </section>
  </main>

  <!-- The back of the card -->
  <footer class="back">
    <svg class="scallops scallops--up" viewBox="0 0 1200 30" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 30c0 0 25-30 50-30s50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30 25-30 50-30 50 30 50 30z" />
    </svg>
    <div class="back__panel">
      <div class="back__message" data-in>
        <p class="back__big">Until we learn together.</p>
        <p>The classes are free to watch, the courses are open, and the door to a private conversation is always open.</p>
        <p>Yisrael</p>
      </div>
      <div class="back__address" data-in>
        <img class="stamp" src="/images/yisrael-smiling-aron-kodesh.jpg" alt="Rav Yisrael Frenkel" width="88" height="117" loading="lazy" />
        <a href={mail}>{site.email}</a>
        <a href={wa}>WhatsApp, +972-58-761-3153</a>
        <a href="/beauty-of-human-desire">The free class</a>
        <a href="/about">About Yisrael</a>
      </div>
      <p class="back__imprint">© {year} Yisrael Frenkel · Nachlaot, Yerushalayim</p>
    </div>
  </footer>
</Layout>

<script>
  // Index with preview: pointing at a chapter opens its picture in one frame level with the row.
  (() => {
    const root = document.querySelector(".index");
    if (!root) return;
    const frame = root.querySelector(".index__frame") as HTMLElement;
    const picture = frame.querySelector("img") as HTMLImageElement;
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    let warmed = false;
    const show = (row: HTMLElement) => {
      if (!fine.matches) return;
      if (!warmed) {
        warmed = true;
        root.querySelectorAll<HTMLElement>("[data-preview]").forEach((a) => {
          new Image().src = a.dataset.preview || "";
        });
      }
      picture.src = row.dataset.preview || "";
      const y = row.offsetTop + row.offsetHeight / 2 - frame.offsetHeight / 2;
      const max = root.offsetHeight - frame.offsetHeight;
      const opening = !frame.classList.contains("is-open");
      if (opening) frame.style.transitionProperty = "clip-path";
      frame.style.transform = `translateY(${Math.min(max, Math.max(0, y))}px)`;
      if (opening) {
        frame.getBoundingClientRect();
        frame.style.transitionProperty = "";
      }
      frame.classList.add("is-open");
    };
    const hide = () => frame.classList.remove("is-open");
    root.querySelectorAll<HTMLElement>(".index__row").forEach((row) => {
      row.addEventListener("pointerenter", () => show(row));
      row.addEventListener("focus", () => show(row));
    });
    root.addEventListener("pointerleave", hide);
    root.addEventListener("focusout", (e) => {
      if (!root.contains((e as FocusEvent).relatedTarget as Node)) hide();
    });
  })();

  // The live thing: "What are you carrying?" marks the matching chapter.
  document.querySelectorAll<HTMLAnchorElement>("#carrying [data-target]").forEach((b) => {
    b.addEventListener("click", () => {
      document.querySelectorAll(".is-marked").forEach((el) => el.classList.remove("is-marked"));
      const t = document.getElementById(b.dataset.target || "");
      if (t) t.classList.add("is-marked");
    });
  });

  // Entrances, once, in reading order.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll("[data-in]").forEach((el) => io.observe(el));
</script>

<style is:global>
  body.sefer {
    --bg: #ecebe7;
    --surface: #e1dfd9;
    --ink: #38450f;
    --muted: #5d683a;
    --field: #38450f;
    --field-ink: #ecebe7;
    --paper: #f3f2ee;
    --display: "Gambarino", "Iowan Old Style", Georgia, serif;
    --text: "General Sans", "Inter", system-ui, sans-serif;
    --hebrew: "Frank Ruhl Libre", "David", "Times New Roman", serif;
    --step-small: clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem);
    --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    --step-lead: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    --step-head: clamp(2rem, 1.3rem + 3.2vw, 4rem);
    --margin: clamp(16px, 3vw, 32px);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 var(--step-body) / 1.5 var(--text);
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  body.sefer { overflow-x: hidden; }
  body.sefer h1, body.sefer h2, body.sefer h3 {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.92;
    color: inherit;
    margin: 0;
  }
  body.sefer p { margin: 0; }
  a { color: inherit; }
  body.sefer img { display: block; max-width: 100%; height: auto; }
  body.sefer ::selection { background: var(--ink); color: var(--bg); }
  body.sefer :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .skip { position: fixed; top: -80px; left: 12px; z-index: 100; background: var(--paper); padding: 10px; }
  .skip:focus { top: 10px; }

  /* entrances */
  .shaar [data-in] > * { opacity: 0; transform: translateY(20px); transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out); }
  .shaar [data-in].in > * { opacity: 1; transform: none; }
  .shaar [data-in].in > :nth-child(2) { transition-delay: 70ms; }
  .shaar [data-in].in > :nth-child(3) { transition-delay: 140ms; }
  .shaar [data-in].in > :nth-child(4) { transition-delay: 210ms; }
  .shaar [data-in].in > :nth-child(5) { transition-delay: 280ms; }
  .shaar [data-in].in > :nth-child(n + 6) { transition-delay: 350ms; }

  /* buttons: one shape, square */
  .button {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 52px; padding: 0 26px;
    background: var(--ink); color: var(--bg);
    font: 500 var(--step-body) / 1 var(--text); text-decoration: none;
    transition: transform 160ms var(--ease-out), background 200ms ease, color 200ms ease;
    touch-action: manipulation; user-select: none; -webkit-user-select: none;
  }
  .button:active { transform: scale(0.97); }
  .button--paper { background: var(--paper); color: var(--ink); }
  .button--line { background: var(--surface); color: var(--ink); min-height: 48px; }
  .button--bar { width: 100%; min-height: 56px; }
  @media (hover: hover) and (pointer: fine) {
    .button:hover { background: #26300a; }
    .button--paper:hover { background: #fff; }
    .button--line:hover { background: var(--ink); color: var(--bg); }
  }

  /* bar */
  .bar { position: absolute; inset: 0 0 auto; z-index: 5; display: flex; align-items: center; gap: 28px; padding: 18px var(--margin); color: var(--field-ink); }
  .bar__mark { font: 400 1.25rem var(--display); text-decoration: none; letter-spacing: 0.01em; }
  .bar__links { display: flex; gap: 22px; margin-left: auto; font-size: var(--step-small); }
  .bar__links a { text-decoration: none; }
  .bar .button { min-height: 44px; padding: 0 18px; font-size: var(--step-small); }

  /* the title page */
  .shaar { background: var(--field); color: var(--field-ink); min-height: 100svh; display: grid; place-items: center; padding: 96px var(--margin) 48px; gap: 28px; }
  .shaar__page { position: relative; width: min(560px, 100%); aspect-ratio: 5 / 7; background: var(--paper); color: var(--ink); display: grid; grid-template-rows: 1fr auto; text-align: center; }
  .shaar__arch { position: absolute; inset: 22px 22px 76px; background: var(--ink); border-radius: 999px 999px 0 0; }
  .shaar__arch > div { position: absolute; inset: 12px; background: var(--paper); border-radius: 999px 999px 0 0; }
  .shaar__text { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 84px 56px 56px; }
  .shaar__he--small { font-size: var(--step-body); margin-top: 18px; color: var(--muted); }
  .shaar__gates { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .shaar__gates a { font: 400 var(--step-lead) / 1.2 var(--display); text-decoration: none; }
  .shaar__gates a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .shaar__he { font: 500 var(--step-lead) var(--hebrew); }
  .shaar h1 { font-size: clamp(2.75rem, 9vw, 4.25rem); }
  .shaar__lead { font: 400 var(--step-lead) / 1.2 var(--display); max-width: 18ch; }
  .shaar__sub { font-size: var(--step-small); color: var(--muted); max-width: 30ch; }
  .shaar__write { font-size: var(--step-small); color: var(--muted); }
  .shaar__write a { text-underline-offset: 3px; }
  .shaar__imprint { position: relative; font-size: var(--step-small); color: var(--muted); padding: 0 24px 22px; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
  .tab { display: inline-flex; align-items: center; min-height: 44px; padding: 0 26px; background: var(--paper); color: var(--ink); text-decoration: none; font-size: var(--step-small); font-weight: 500; clip-path: polygon(10px 0, calc(100% - 10px) 0, 100% 100%, 0 100%); transition: transform 160ms var(--ease-out); }
  .tab:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .tab:hover { background: #fff; } }

  /* contents */
  .contents { padding: clamp(96px, 12vw, 180px) var(--margin) clamp(96px, 12vw, 160px); }
  .contents__head { max-width: 62ch; margin-bottom: clamp(48px, 7vw, 96px); }
  .contents__head h2 { font-size: var(--step-head); margin-bottom: 24px; }
  .contents__head > p { font-size: var(--step-lead); line-height: 1.35; font-family: var(--display); max-width: 30ch; }
  .carrying { margin-top: 36px; }
  .carrying > p { font-weight: 500; margin-bottom: 12px; }
  .carrying__row { display: flex; flex-wrap: wrap; gap: 8px; }

  .index { position: relative; }
  .index__list { display: grid; gap: clamp(56px, 8vw, 96px); }
  .gate { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 16px clamp(24px, 4vw, 48px); align-items: start; }
  .gate__plate { grid-row: 1 / 4; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gate h3 { font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem); margin-bottom: 0; }
  .gate__lead { margin-bottom: 0 !important; }
  @media (max-width: 720px) { .gate { grid-template-columns: 1fr; } .gate__plate { grid-row: auto; aspect-ratio: 4 / 3; } }
  .gate__lead { color: var(--muted); margin-bottom: 18px; max-width: 48ch; }
  .gate ul { list-style: none; margin: 0; padding: 0; min-width: 0; }
  .gate, .gate li, .index__list > * { min-width: 0; }
  .gate.is-marked { background: var(--surface); margin-inline: calc(-1 * var(--margin)); padding: 20px var(--margin); }
  .index__row { max-width: 100%; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 12px; padding: 14px 0; text-decoration: none; transition: opacity 240ms ease, background 200ms ease; }
  .index__row.is-marked, .index__row:active { background: var(--surface); }
  .index__name { font: 400 clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem) / 1.05 var(--display); display: flex; flex-direction: column; gap: 4px; min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  .index__text i { font-style: normal; color: var(--ink); }
  .index__dots { flex: 1 1 0; width: 0; min-width: 0; overflow: hidden; white-space: nowrap; color: var(--muted); align-self: end; margin-bottom: 0.35em; }
  .index__dots::after { content: "· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · ·"; }
  .index__status { font-size: var(--step-small); font-weight: 500; margin-left: auto; }
  .index__text { flex-basis: 100%; color: var(--muted); font-size: var(--step-small); margin-top: 4px; max-width: 60ch; }
  .index__thumb { order: -1; width: 72px; height: 72px; flex: none; object-fit: cover; align-self: center; margin-right: 6px; }
  .index__frame { display: none; }
  @media (hover: hover) and (pointer: fine) and (min-width: 900px) {
    body.sefer .index__thumb { display: none; }
    .index__list:has(.index__row:hover, .index__row:focus-visible) .index__row:not(:hover, :focus-visible) { opacity: 0.4; }
    .index__frame { display: block; position: absolute; top: 0; left: 0; width: calc((100% - clamp(24px, 4vw, 48px)) / 2.4); aspect-ratio: 4 / 3; z-index: 1; pointer-events: none; clip-path: inset(100% 0 0 0); transition: clip-path 320ms var(--ease-out), transform 360ms var(--ease-out); }
    .index__frame.is-open { clip-path: inset(0); }
    .index__frame img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 1200ms var(--ease-out); }
    .index__frame.is-open img { transform: none; }
  }

  /* the letter */
  .letter { background: var(--field); padding: 64px var(--margin) 64px; display: grid; justify-items: center; }
  .sheet { width: min(640px, 100%); background: var(--paper); padding: clamp(28px, 6vw, 60px); display: grid; gap: 20px; }
  .sheet__portrait { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: 60% 25%; }
  .sheet p { font-size: var(--step-body); line-height: 1.55; }
  .sheet__sign { font: 400 1.5rem var(--display); margin-top: 8px; }
  .sheet__role { font-size: var(--step-small) !important; color: var(--muted); margin-top: -12px; }
  .scallops { display: block; width: min(640px, 100%); height: 24px; fill: var(--paper); }
