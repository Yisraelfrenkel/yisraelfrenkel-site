---
import SeatsLayout from "../../layouts/SeatsLayout.astro";
import SeatMap from "../../components/seats/SeatMap.astro";
import { config } from "../../data/seating.js";
---

<SeatsLayout title={config.shulName} subtitle={`Seating · ${config.season}`}>
  <div class="card" id="gate" hidden style="max-width:440px;margin:0 auto">
    <p id="gate-intro" class="muted" style="margin:0 0 1rem"></p>
    <div class="field">
      <label for="token" id="token-label">Admin password</label>
      <input type="password" id="token" autocomplete="current-password" />
    </div>
    <button class="btn" id="unlock" style="width:100%">Unlock</button>
    <p class="err" id="gate-error" hidden></p>
  </div>

  <div id="panel" hidden>
    <div class="card" style="margin-bottom:1.5rem">
      <p style="margin:0 0 1rem;font-size:0.9rem">
        Tap any seat to place, edit or clear it. Placing a name here skips
        payment — use it for the seats you've already promised.
      </p>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
        <button class="btn btn--ghost" id="export">Download list (CSV)</button>
        <button class="btn btn--ghost" id="reload">Refresh</button>
      </div>
      <p class="ok" id="msg" hidden></p>
    </div>

    <SeatMap mode="pick" />

    <div class="card" id="editor" hidden style="position:sticky;bottom:1rem;margin-top:1.5rem;box-shadow:0 8px 30px rgba(43,36,32,0.18)">
      <p style="margin:0 0 0.75rem;font-weight:600" id="editor-title"></p>
      <div class="field">
        <label for="ed-name">Name</label>
        <input type="text" id="ed-name" maxlength="40" />
      </div>
      <div class="field">
        <label for="ed-phone">Phone</label>
        <input type="tel" id="ed-phone" maxlength="24" />
      </div>
      <div class="field">
        <label for="ed-note">Note (paid in cash, family of…, etc.)</label>
        <input type="text" id="ed-note" maxlength="80" />
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
        <button class="btn" id="ed-save">Save</button>
        <button class="btn btn--ghost" id="ed-clear">Free this seat</button>
        <button class="btn btn--ghost" id="ed-cancel">Cancel</button>
      </div>
      <p class="err" id="ed-error" hidden></p>
    </div>
  </div>
</SeatsLayout>

<script>
  import { paintSeats, fetchSeats } from "../../scripts/seats-client.js";

  const $ = (id) => document.getElementById(id);
  let token = sessionStorage.getItem("adminToken") || "";
  let data = null;
  let editing = null;
  let firstRun = false;

  async function api(path, options = {}) {
    const res = await fetch(path, {
      ...options,
      headers: {
        "content-type": "application/json",
        authorization: `Bearer ${token}`,
        ...(options.headers || {}),
      },
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || `Error ${res.status}`);
    return body;
  }

  async function load() {
    data = await fetchSeats();
    paintSeats(data);
  }

  async function enter() {
    $("gate").hidden = true;
    $("panel").hidden = false;
    await load();
  }

  async function unlock() {
    token = $("token").value.trim();
    $("gate-error").hidden = true;
    try {
      if (firstRun) {
        // Nobody has claimed this chart yet — this visit sets the password.
        const res = await fetch("/api/admin/setup", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ password: token }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || `Error ${res.status}`);
        firstRun = false;
      }
      await api("/api/admin/ping");
      sessionStorage.setItem("adminToken", token);
      await enter();
    } catch (err) {
      $("gate-error").textContent = err.message;
      $("gate-error").hidden = false;
    }
  }

  $("unlock").addEventListener("click", unlock);
  $("token").addEventListener("keydown", (e) => e.key === "Enter" && unlock());

  (async () => {
    // A password already in this tab gets us straight in.
    if (token) {
      try {
        await api("/api/admin/ping");
        return enter();
      } catch {
        sessionStorage.removeItem("adminToken");
        token = "";
      }
    }

    try {
      const status = await (await fetch("/api/admin/status", { cache: "no-store" })).json();
      firstRun = Boolean(status.needsSetup);
    } catch {
      firstRun = false;
    }

    $("gate-intro").textContent = firstRun
      ? "Nobody has set a password for this chart yet. Choose one now — it's what will unlock this page from here on, so write it down."
      : "";
    $("gate-intro").hidden = !firstRun;
    $("token-label").textContent = firstRun ? "Choose an admin password" : "Admin password";
    $("token").setAttribute("autocomplete", firstRun ? "new-password" : "current-password");
    $("unlock").textContent = firstRun ? "Set password" : "Unlock";
    $("gate").hidden = false;
    $("token").focus();
  })();

  document.addEventListener("click", (e) => {
    const el = e.target.closest("#panel .seat");
    if (!el) return;
    editing = el.dataset.seat;
    const rec = (data && data.seats[editing]) || {};
    const num = el.querySelector(".seat-num").textContent;
    $("editor-title").textContent =
      `${el.dataset.section === "men" ? "Men" : "Women"} — seat ${num}`;
    $("ed-name").value = rec.name || "";
    $("ed-phone").value = rec.phone || "";
    $("ed-note").value = rec.note || "";
    $("ed-error").hidden = true;
    $("editor").hidden = false;
    $("editor").scrollIntoView({ behavior: "smooth", block: "nearest" });
  });

  function flash(text) {
    $("msg").textContent = text;
    $("msg").hidden = false;
    setTimeout(() => ($("msg").hidden = true), 2500);
  }

  $("ed-save").addEventListener("click", async () => {
    try {
      await api("/api/admin/seat", {
        method: "POST",
        body: JSON.stringify({
          seatId: editing,
          name: $("ed-name").value.trim(),
          phone: $("ed-phone").value.trim(),
          note: $("ed-note").value.trim(),
        }),
      });
      $("editor").hidden = true;
      await load();
      flash("Saved.");
    } catch (err) {
      $("ed-error").textContent = err.message;
      $("ed-error").hidden = false;
    }
  });

  $("ed-clear").addEventListener("click", async () => {
    if (!confirm("Free this seat? The name and phone will be deleted.")) return;
    try {
      await api("/api/admin/seat", {
        method: "POST",
        body: JSON.stringify({ seatId: editing, clear: true }),
      });
      $("editor").hidden = true;
      await load();
      flash("Seat freed.");
    } catch (err) {
      $("ed-error").textContent = err.message;
      $("ed-error").hidden = false;
    }
  });

  $("ed-cancel").addEventListener("click", () => ($("editor").hidden = true));
  $("reload").addEventListener("click", () => load().then(() => flash("Refreshed.")));

  $("export").addEventListener("click", async () => {
    const rows = await api("/api/admin/export");
    const csv = [
      "section,seat,name,phone,receipt,seats_on_receipt,note,claimed_at",
      ...rows.rows.map((r) =>
        [r.section, r.number, r.name, r.phone, r.receipt, r.paid_for, r.note, r.claimed_at]
          .map((v) => `"${String(v ?? "").replace(/"/g, '""')}"`)
          .join(",")
      ),
    ].join("\n");
    const url = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
    const a = document.createElement("a");
    a.href = url;
    a.download = "seating.csv";
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
