---
import SeatsLayout from "../../layouts/SeatsLayout.astro";
import SeatMap from "../../components/seats/SeatMap.astro";
import { config, priceOne, priceTwo } from "../../data/seating.js";

export function getStaticPaths() {
  const slug = config.claimPath.replace(/^\/seats\//, "").replace(/\/$/, "");
  return [{ params: { slug } }];
}
---

<SeatsLayout
  title="Choose your seat"
  subtitle={`${config.shulName} · ${config.season}`}
>
  <form class="card" id="claim-form" style="margin-bottom:2rem">
    <div class="field">
      <label for="receipt">Cardcom confirmation number</label>
      <input
        type="text"
        id="receipt"
        name="receipt"
        required
        autocomplete="off"
        inputmode="numeric"
        placeholder="From your payment receipt"
      />
      <p class="muted" style="margin:0.35rem 0 0">
        It's on the receipt Cardcom emailed you.
      </p>
    </div>

    <div class="field">
      <label>What did you pay for?</label>
      <div class="choices">
        <label class="choice">
          <input type="radio" name="seats" value="1" checked />
          <span>{priceOne}</span>
        </label>
        <label class="choice">
          <input type="radio" name="seats" value="2" />
          <span>{priceTwo}</span>
        </label>
      </div>
      <p class="muted" style="margin:0.35rem 0 0">
        Paying for two lets you take a second seat with the same number.
      </p>
    </div>

    <div class="field">
      <label for="name">Name as it should appear on the chart</label>
      <input type="text" id="name" name="name" required maxlength="40" placeholder="e.g. R' Moshe Cohen" />
    </div>

    <div class="field">
      <label for="phone">Phone (so the gabbai can reach you)</label>
      <input type="tel" id="phone" name="phone" required maxlength="24" placeholder="05X-XXX-XXXX" />
    </div>

    <div class="field" style="margin-bottom:0.5rem">
      <label>Seat</label>
      <p id="chosen" class="muted" style="margin:0">
        Tap an open seat on the chart below.
      </p>
    </div>

    <button class="btn" type="submit" id="submit" disabled style="width:100%;margin-top:0.75rem">
      Take this seat
    </button>
    <p class="err" id="error" hidden></p>
  </form>

  <SeatMap mode="pick" />

  <p class="muted" style="margin-top:1.5rem;text-align:center">
    Seats are first come, first served. A seat is yours the moment it turns gold.
  </p>
  <style>
    .choices {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .choice {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      flex: 1 1 160px;
      margin: 0;
      padding: 0.6rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 5px;
      background: #fff;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
    }
    .choice:has(input:checked) {
      border-color: var(--gold);
      background: var(--gold-soft);
    }
  </style>
</SeatsLayout>

<script>
  import { refreshSeats, paintSeats, fetchSeats } from "../../scripts/seats-client.js";

  const form = document.getElementById("claim-form");
  const chosenEl = document.getElementById("chosen");
  const submitEl = document.getElementById("submit");
  const errorEl = document.getElementById("error");
  let chosen = null;

  function selectSeat(el) {
    if (el.dataset.status === "taken") return;
    for (const s of document.querySelectorAll(".seat[aria-pressed='true']")) {
      s.setAttribute("aria-pressed", "false");
    }
    el.setAttribute("aria-pressed", "true");
    chosen = el.dataset.seat;
    const section = el.dataset.section === "men" ? "Men" : "Women";
    const num = el.querySelector(".seat-num").textContent;
    chosenEl.textContent = `${section} — seat ${num}`;
    chosenEl.classList.remove("muted");
    submitEl.disabled = false;
  }

  document.querySelector(".room").addEventListener("click", (e) => {
    const el = e.target.closest(".seat");
    if (el) selectSeat(el);
  });

  function clearChoiceIfGone() {
    if (!chosen) return;
    const el = document.querySelector(`.seat[data-seat="${chosen}"]`);
    if (el && el.dataset.status === "taken") {
      chosen = null;
      submitEl.disabled = true;
      chosenEl.textContent = "That seat was just taken — please choose another.";
      chosenEl.classList.add("muted");
    } else if (el) {
      el.setAttribute("aria-pressed", "true");
    }
  }

  async function refresh() {
    try {
      paintSeats(await fetchSeats());
      clearChoiceIfGone();
    } catch {}
  }

  // Coming back for the second seat of a pair payment: don't make them dig the
  // confirmation number out of their email again.
  const carried = sessionStorage.getItem("receipt");
  if (carried) {
    form.receipt.value = carried;
    form.querySelector("input[name='seats'][value='2']").checked = true;
  }

  refresh();
  setInterval(refresh, 12000);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    submitEl.disabled = true;
    submitEl.textContent = "Saving…";

    const body = {
      seatId: chosen,
      receipt: form.receipt.value.trim(),
      name: form.name.value.trim(),
      phone: form.phone.value.trim(),
      seats: Number(form.querySelector("input[name='seats']:checked").value),
    };

    try {
      const res = await fetch("/api/claim", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Something went wrong.");

      sessionStorage.setItem("seat", JSON.stringify(data.seat));
      sessionStorage.setItem("seatsRemaining", String(data.remaining ?? 0));
      // Carry the number over so a pair payment doesn't have to retype it.
      sessionStorage.setItem("receipt", data.remaining > 0 ? body.receipt : "");
      location.href = "/seats/confirmed/";
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.hidden = false;
      submitEl.disabled = false;
      submitEl.textContent = "Take this seat";
      refresh();
    }
  });
</script>
