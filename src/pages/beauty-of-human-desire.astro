---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/content.js";
import BhdHero from "../components/bhd/BhdHero.astro";
import BhdOpeningStory from "../components/bhd/BhdOpeningStory.astro";
import BhdReveal from "../components/bhd/BhdReveal.astro";
import BhdSteps from "../components/bhd/BhdSteps.astro";
import BhdTorah from "../components/bhd/BhdTorah.astro";
import BhdJourney from "../components/bhd/BhdJourney.astro";
import BhdTestimonials from "../components/bhd/BhdTestimonials.astro";
import BhdContact from "../components/bhd/BhdContact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import AboutFloat from "../components/AboutFloat.astro";
---

<Layout
  title={`The Beauty of Human Desire — ${site.title}`}
  description={site.description}
>
  <main class="bhd-page">
    <BhdHero />
    <BhdOpeningStory />
    <BhdReveal />
    <BhdSteps />
    <BhdTorah />
    <BhdJourney />
    <div class="bhd-tint-3">
      <BhdTestimonials />
      <BhdContact />
      <Footer />
    </div>
  </main>
  <AboutFloat />
  <WhatsAppFloat />
</Layout>

<style is:global>
  .bhd-page {
    /* Design tokens — type system "B / Spacious Editorial", the approved
       default from design_handoff_beauty_of_human_desire (2026-08-07). */
    --bhd-h1: 52px;
    --bhd-h2: 30px;
    --bhd-h3: 22px;
    --bhd-body: 18px;
    --bhd-body-lh: 1.65;
    --bhd-quote: 23px;
    --bhd-quote-lg: 34px;
    --bhd-para-gap: 1.5em;
    --bhd-hero-pad: 104px;
    --bhd-section-pad: 88px;

    --bhd-parchment: #f8f3ea;
    --bhd-parchment-2: #f3eee4;
    --bhd-parchment-3: #fcfaf6;
    --bhd-parchment-4: #efe9df;
    --bhd-text: #4f3422;
    --bhd-accent: #a4704f;

    --bhd-serif: "Cormorant Garamond", serif;
    --bhd-sans: "Inter", system-ui, sans-serif;

    background: var(--bhd-parchment);
    color: var(--bhd-text);
    width: 100%;
    overflow-x: hidden;
  }
  .bhd-tint-3 {
    background: var(--bhd-parchment-3);
    width: 100%;
  }

  /* Phones were being served the desktop type scale and the desktop
     vertical rhythm, which is what made the page feel endless. Every
     size on this page derives from these tokens, so scaling them here
     scales the whole page proportionally. */
  @media (max-width: 640px) {
    .bhd-page {
      --bhd-h1: 29px;
      --bhd-h2: 24px;
      --bhd-h3: 19px;
      --bhd-body: 17px;
      --bhd-body-lh: 1.6;
      /* The display lines multiply these by up to 2.7×, so they have to
         come down hard or a single sentence fills the whole screen. */
      --bhd-quote: 17px;
      --bhd-quote-lg: 17px;
      --bhd-para-gap: 1.3em;
      --bhd-hero-pad: 56px;
      --bhd-section-pad: 44px;
    }
  }
</style>

<script>
  if (window.location.hash === "#continue") {
    window.addEventListener("load", () => {
      document.getElementById("continue")?.scrollIntoView({ block: "start" });
    });
  }
</script>
