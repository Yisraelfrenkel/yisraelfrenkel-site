---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/content.js";
import StartHero from "../components/StartHero.astro";
import FreeClass from "../components/FreeClass.astro";
import ContinueJourney from "../components/ContinueJourney.astro";
import StepsTeaser from "../components/StepsTeaser.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title={`Start Here — ${site.title}`}
  description="A free class on the beauty of human desire — the doorway into Rav Yisrael Frenkel's work."
>
  <header class="minimal-nav">
    <div class="container">
      <a href="/" class="nav-name">{site.title}</a>
    </div>
  </header>
  <main>
    <StartHero />
    <FreeClass />
    <ContinueJourney />
    <StepsTeaser />
  </main>
  <Footer />
</Layout>

<style>
  .minimal-nav {
    padding-top: 1.5rem;
  }
  .nav-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
  }
</style>
