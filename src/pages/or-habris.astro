---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/content.js";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Bridge from "../components/Bridge.astro";
import Course from "../components/Course.astro";
import WhyOrHabris from "../components/WhyOrHabris.astro";
import ChaburahInfo from "../components/ChaburahInfo.astro";
import Experience from "../components/Experience.astro";
import Testimonials from "../components/Testimonials.astro";
import Bio from "../components/Bio.astro";
import PracticalDetails from "../components/PracticalDetails.astro";
import FAQ from "../components/FAQ.astro";
import SignupSection from "../components/SignupSection.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
---

<Layout
  title={`Or HaBris — ${site.title}`}
  description="A five-week small-group journey for men who want to understand their desires, heal shame, and build a more fulfilling life."
>
  <Nav />
  <main>
    <Hero />
    <Bridge />
    <Course />
    <WhyOrHabris />
    <ChaburahInfo />
    <Experience />
    <Testimonials />
    <Bio />
    <PracticalDetails />
    <FAQ />
    <SignupSection />
    <Contact />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
