---
import Layout from "../layouts/Layout.astro";
import { site, about, invitations } from "../data/content.js";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

// blocks[0] is the "intro" entrance line. blocks[1] and blocks[2] (a "p"
// and a "line") are the two paragraphs that flow beside the floated
// portrait. Everything from blocks[3] on (starting with "credentials")
// renders in the normal narrow reading column.
const [introBlock, floatP, floatLine, ...restBlocks] = about.blocks;
---

<Layout
  title={`About Yisrael — ${site.title}`}
  description={about.metaDescription}
>
  <main class="about-page">
    <section class="hero">
      <div class="eyebrow">{about.eyebrow}</div>
      <h1>
        {about.heading[0]}<br />
        {about.heading[1]}
      </h1>
    </section>

    <section class="intro">
      <p>{introBlock.text}</p>
    </section>

    <section class="essay-open">
      <img class="portrait-float" src={about.portraitMain} alt="Portrait of Rav Yisrael Frenkel" />
      <p>{floatP.text}</p>
      <p>{floatLine.text}</p>
      <div class="clearfix"></div>
    </section>

    {restBlocks.map((block) => (
      <>
        {block.type === "p" && <p class="essay-p">{block.text}</p>}

        {block.type === "line" && <p class="essay-line">{block.text}</p>}

        {block.type === "credentials" && (
          <div class="credentials">
            <p class="credentials-lead">{block.lead}</p>
            <div class="credentials-list">
              {block.items.map((item) => <p class="credentials-item">{item}</p>)}
            </div>
            <p class="credentials-closing">{block.closing}</p>
          </div>
        )}

        {block.type === "photo" && (
          <div class="photo-wide">
            <img src={about.portraitTeaching} alt="Rav Yisrael Frenkel teaching" />
          </div>
        )}

        {block.type === "quote" && (
          <div class="pull-quote">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <p>
              {block.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </div>
        )}

        {block.type === "turn" && (
          <div class="turn">
            <p class="turn-lead">{block.lead}</p>
            <p class="turn-emphasis">{block.emphasis}</p>
          </div>
        )}

        {block.type === "close" && <p class="close">{block.text}</p>}

        {block.type === "credentials" && (
          <div class="divider" aria-hidden="true">
            <span class="divider-line"></span>
            <span class="divider-mark">✦</span>
            <span class="divider-line"></span>
          </div>
        )}
      </>
    ))}

    <section class="invitations">
      <div class="row">
        {invitations.map((card) => (
          <a href={card.href} class="invitation" target="_blank" rel="noopener noreferrer">
            <div class="invitation-title">{card.title}</div>
            <div class="invitation-desc">{card.description}</div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .about-page {
    --ab-parchment: #f8f3ea;
    --ab-parchment-2: #f3eee4;
    --ab-text: #4f3422;
    --ab-accent: #a4704f;
    --ab-serif: "Cormorant Garamond", serif;
    --ab-sans: "Inter", system-ui, sans-serif;
    background: var(--ab-parchment);
    color: var(--ab-text);
    width: 100%;
    overflow-x: hidden;
  }

  /* ---------- Hero: the entrance ---------- */
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 120px 32px 20px;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--ab-sans);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(79, 52, 34, 0.55);
    margin-bottom: 28px;
  }
  .hero h1 {
    font-family: var(--ab-serif);
    font-size: 68px;
    font-weight: 500;
    font-style: italic;
    line-height: 1.15;
    margin: 0;
    color: var(--ab-text);
  }

  .intro {
    max-width: 700px;
    margin: 0 auto;
    padding: 8px 32px 72px;
    text-align: center;
  }
  .intro p {
    font-family: var(--ab-serif);
    font-size: 27px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ab-text);
    margin: 0;
  }

  /* ---------- Opening flow: portrait floats beside the first lines ---------- */
  .essay-open {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 32px 12px;
    text-align: left;
  }
  .portrait-float {
    float: right;
    width: 380px;
    max-width: 44%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    margin: 6px 0 32px 44px;
    border-radius: 4px;
  }
  .essay-open p {
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    margin: 0 0 27px;
    color: var(--ab-text);
  }
  .clearfix {
    clear: both;
  }

  /* ---------- Standard narrow reading column ---------- */
  .essay-p {
    max-width: 840px;
    margin: 0 auto 27px;
    padding: 0 32px;
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ab-text);
    text-align: left;
  }
  .essay-line {
    max-width: 620px;
    margin: 48px auto;
    padding: 0 32px;
    font-family: var(--ab-serif);
    font-size: 25px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ab-text);
    text-align: center;
  }

  /* ---------- Credentials: broken visually, not bulleted ---------- */
  .credentials {
    max-width: 840px;
    margin: 44px auto;
    padding: 0 32px;
  }
  .credentials-lead {
    font-family: var(--ab-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ab-text);
    margin: 0 0 18px;
  }
  .credentials-list {
    padding-left: 20px;
    border-left: 2px solid rgba(164, 112, 79, 0.35);
  }
  .credentials-item {
    font-family: var(--ab-sans);
    font-size: 17px;
    line-height: 1.6;
    color: rgba(79, 52, 34, 0.85);
    margin: 0 0 14px;
  }
  .credentials-item:last-child {
    margin-bottom: 0;
  }
  .credentials-closing {
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ab-text);
    margin: 24px 0 0;
  }

  /* ---------- The one visual moment ---------- */
  .divider {
    max-width: 420px;
    margin: 72px auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .divider-line {
    flex: 1 1 auto;
    height: 1px;
    background: rgba(164, 112, 79, 0.4);
  }
  .divider-mark {
    font-size: 15px;
    color: var(--ab-accent);
  }

  /* ---------- Teaching photo ---------- */
  .photo-wide {
    max-width: 900px;
    margin: 0 auto;
    padding: 44px 32px;
  }
  .photo-wide img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  /* ---------- The pull quote: the moment that stops people ---------- */
  .pull-quote {
    max-width: 900px;
    margin: 0 auto;
    padding: 24px 32px 96px;
    text-align: center;
  }
  .quote-mark {
    font-family: var(--ab-serif);
    font-size: 110px;
    line-height: 0.5;
    color: var(--ab-accent);
    opacity: 0.5;
    margin-bottom: 8px;
  }
  .pull-quote p {
    font-family: var(--ab-serif);
    font-size: 46px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.42;
    color: var(--ab-accent);
    margin: 0;
  }

  /* ---------- The turn: the hinge of the piece ---------- */
  .turn {
    max-width: 760px;
    margin: 56px auto;
    padding: 0 32px;
    text-align: center;
  }
  .turn-lead {
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ab-text);
    margin: 0 0 14px;
  }
  .turn-emphasis {
    font-family: var(--ab-serif);
    font-size: 30px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ab-accent);
    margin: 0;
  }

  /* ---------- Closing statement ---------- */
  .close {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 32px 88px;
    font-family: var(--ab-serif);
    font-size: 24px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.55;
    color: var(--ab-text);
    text-align: center;
  }

  /* ---------- Invitations ---------- */
  .invitations {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 32px 64px;
    text-align: center;
  }
  .row {
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
  }
  .invitation {
    display: block;
    flex: 1 1 240px;
    max-width: 280px;
    padding: 34px 38px;
    background: var(--ab-parchment);
    border: 1px solid rgba(79, 52, 34, 0.25);
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.5s ease, border-color 0.5s ease;
    text-align: left;
  }
  .invitation:hover {
    background: var(--ab-parchment-2);
    border-color: var(--ab-accent);
  }
  .invitation:first-child {
    border-color: var(--ab-accent);
  }
  .invitation:first-child:hover {
    border-color: var(--ab-text);
  }
  .invitation-title {
    font-family: var(--ab-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--ab-text);
    margin-bottom: 8px;
  }
  .invitation-desc {
    font-family: var(--ab-sans);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(79, 52, 34, 0.7);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 88px;
    }
    .hero h1 {
      font-size: 44px;
    }
    .intro p {
      font-size: 22px;
    }
    .portrait-float {
      float: none;
      width: 220px;
      max-width: 60%;
      margin: 0 auto 24px;
    }
    .essay-open p {
      text-align: left;
    }
    .pull-quote p {
      font-size: 32px;
    }
  }
</style>
