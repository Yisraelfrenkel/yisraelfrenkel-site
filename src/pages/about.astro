---
import Layout from "../layouts/Layout.astro";
import { site, about, invitations } from "../data/content.js";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

// blocks[0] is the "intro" entrance line. blocks[1] (a "p") is the
// paragraph that flows beside the floated portrait. blocks[2] (a "line")
// renders on its own beneath the photo, once the float clears. Everything
// from blocks[3] on (starting with "credentials") renders in the normal
// narrow reading column.
const [introBlock, floatP, lineUnderPhoto, ...restBlocks] = about.blocks;
---

<Layout
  title={`About Yisrael — ${site.title}`}
  description={about.metaDescription}
>
  <main class="about-page">
    <section class="hero">
      <div class="eyebrow">{about.eyebrow}</div>
      <h1>
        {about.heading[0]}<br />
        {about.heading[1]}
      </h1>
    </section>

    <section class="intro">
      <p>{introBlock.text}</p>
    </section>

    <section class="essay-open">
      <img class="portrait-float" src={about.portraitMain} alt="Portrait of Rav Yisrael Frenkel" />
      <p class="float-p">{floatP.text}</p>
      <div class="clearfix"></div>
    </section>

    <p class="line-under-photo">{lineUnderPhoto.text}</p>

    {restBlocks.map((block) => (
      <>
        {block.type === "p" && <p class="essay-p">{block.text}</p>}

        {block.type === "line" && <p class="essay-line">{block.text}</p>}

        {block.type === "credentials" && (
          <div class="credentials">
            <p class="credentials-lead">{block.lead}</p>
            <div class="credentials-list">
              {block.items.map((item) => <p class="credentials-item">{item}</p>)}
            </div>
            <p class="credentials-closing">{block.closing}</p>
          </div>
        )}

        {block.type === "rabbeim" && (
          <div class="rabbeim">
            <p class="rabbeim-lead">{block.lead}</p>
            {block.items.map((r) => (
              <p class="rabbeim-item">
                <span class="rabbeim-name">{r.name}</span>{r.text}
              </p>
            ))}
            <p class="rabbeim-closing">{block.closing}</p>
          </div>
        )}

        {block.type === "photo" && (
          <div class="photo-wide">
            <img src={block.src} alt={block.alt} />
          </div>
        )}

        {block.type === "quote" && (
          <div class="pull-quote">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <p>
              {block.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </div>
        )}

        {block.type === "turn" && (
          <div class="turn">
            <p class="turn-lead">{block.lead}</p>
            <p class="turn-emphasis">{block.emphasis}</p>
          </div>
        )}

        {block.type === "close" && <p class="close">{block.text}</p>}

        {block.type === "credentials" && (
          <div class="divider" aria-hidden="true">
            <span class="divider-line"></span>
            <span class="divider-mark">✦</span>
            <span class="divider-line"></span>
          </div>
        )}
      </>
    ))}

    <section class="invitations">
      <div class="row">
        {invitations.map((card) => (
          <a href={card.href} class="invitation" target="_blank" rel="noopener noreferrer">
            <div class="invitation-title">{card.title}</div>
            <div class="invitation-desc">{card.description}</div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .about-page {
    --ab-parchment: #f8f3ea;
    --ab-parchment-2: #f3eee4;
    --ab-text: #4f3422;
    --ab-accent: #a4704f;
    --ab-serif: "Cormorant Garamond", serif;
    --ab-sans: "Inter", system-ui, sans-serif;
    background: var(--ab-parchment);
    color: var(--ab-text);
    width: 100%;
    overflow-x: hidden;
  }

  /* ---------- Hero: the entrance ---------- */
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 120px 32px 20px;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--ab-sans);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(79, 52, 34, 0.55);
    margin-bottom: 28px;
  }
  .hero h1 {
    font-family: var(--ab-serif);
    font-size: 68px;
    font-weight: 500;
    font-style: italic;
    line-height: 1.15;
    margin: 0;
    color: var(--ab-text);
  }

  .intro {
    max-width: 700px;
    margin: 0 auto;
    padding: 8px 32px 72px;
    text-align: center;
  }
  .intro p {
    font-family: var(--ab-serif);
    font-size: 27px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ab-text);
    margin: 0;
  }

  /* ---------- Opening flow: portrait floats beside the first lines ---------- */
  /* Two columns rather than a float: the paragraph is short and the photo
     is tall, so floating left a hole above the text and squeezed it into
     a five-word measure. A grid lets the text sit centred against the
     photo at a readable line length. */
  .essay-open {
    /* matches .essay-p so the paragraph's left edge lines up with the
       body text above and below it */
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 32px 12px;
    text-align: left;
    display: grid;
    grid-template-columns: 1fr 380px;
    column-gap: 48px;
    align-items: center;
  }
  .portrait-float {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    margin: 0;
    border-radius: 4px;
  }
  .float-p {
    grid-column: 1;
    grid-row: 1;
    /* capped so the measure stays readable even though the column is wide */
    max-width: 640px;
    font-family: var(--ab-sans);
    font-size: 21px;
    line-height: 1.65;
    margin: 0;
    color: var(--ab-text);
  }
  .clearfix {
    clear: both;
  }
  .line-under-photo {
    max-width: 700px;
    margin: 0 auto 12px;
    padding: 0 32px;
    font-family: var(--ab-serif);
    font-size: 30px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ab-accent);
    text-align: center;
  }

  /* ---------- Standard narrow reading column ---------- */
  .essay-p {
    max-width: 1300px;
    margin: 0 auto 27px;
    padding: 0 32px;
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ab-text);
    text-align: left;
  }
  .essay-line {
    max-width: 620px;
    margin: 48px auto;
    padding: 0 32px;
    font-family: var(--ab-serif);
    font-size: 25px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ab-text);
    text-align: center;
  }

  /* ---------- Credentials: broken visually, not bulleted ---------- */
  .credentials {
    max-width: 1300px;
    margin: 44px auto;
    padding: 0 32px;
  }
  .credentials-lead {
    font-family: var(--ab-serif);
    font-style: italic;
    font-size: 25px;
    color: var(--ab-text);
    margin: 0 0 18px;
  }
  .credentials-list {
    padding-left: 20px;
    border-left: 2px solid rgba(164, 112, 79, 0.35);
  }
  .credentials-item {
    font-family: var(--ab-sans);
    font-size: 17px;
    line-height: 1.6;
    color: rgba(79, 52, 34, 0.85);
    margin: 0 0 14px;
  }
  .credentials-item:last-child {
    margin-bottom: 0;
  }
  .credentials-closing {
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ab-text);
    margin: 24px 0 0;
  }

  /* ---------- Rabbeim ---------- */
  /* Same reading column as the credentials, but set as prose rather than
     a list — each line is a sentence about what was received, not an entry. */
  .rabbeim {
    max-width: 1300px;
    margin: 44px auto;
    padding: 0 32px;
  }
  .rabbeim-lead {
    font-family: var(--ab-serif);
    font-style: italic;
    font-size: 25px;
    color: var(--ab-text);
    margin: 0 0 22px;
  }
  .rabbeim-item {
    max-width: 780px;
    font-family: var(--ab-sans);
    font-size: 17px;
    line-height: 1.7;
    color: rgba(79, 52, 34, 0.85);
    margin: 0 0 20px;
  }
  .rabbeim-item:last-of-type {
    margin-bottom: 0;
  }
  .rabbeim-name {
    color: var(--ab-text);
    font-weight: 600;
  }
  .rabbeim-closing {
    font-family: var(--ab-serif);
    font-style: italic;
    font-size: 21px;
    line-height: 1.5;
    color: var(--ab-accent);
    text-align: center;
    margin: 40px 0 48px;
    text-wrap: pretty;
  }

  /* ---------- The one visual moment ---------- */
  .divider {
    max-width: 420px;
    margin: 72px auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .divider-line {
    flex: 1 1 auto;
    height: 1px;
    background: rgba(164, 112, 79, 0.4);
  }
  .divider-mark {
    font-size: 15px;
    color: var(--ab-accent);
  }

  /* ---------- Study-desk photo — kept at its natural portrait
     proportions rather than cropped into a wide 16:9 band, so the
     room (the point of the shot) stays in frame. ---------- */
  .photo-wide {
    max-width: 560px;
    margin: 0 auto;
    padding: 44px 32px;
  }
  .photo-wide img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  /* ---------- The pull quote: the moment that stops people ---------- */
  .pull-quote {
    max-width: 1040px;
    margin: 0 auto;
    padding: 24px 24px 96px;
    text-align: center;
  }
  .quote-mark {
    font-family: var(--ab-serif);
    font-size: 130px;
    line-height: 0.5;
    color: var(--ab-accent);
    opacity: 0.5;
    margin-bottom: 8px;
  }
  .pull-quote p {
    font-family: var(--ab-serif);
    font-size: 54px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.38;
    color: var(--ab-accent);
    margin: 0;
  }

  /* ---------- The turn: the hinge of the piece ---------- */
  .turn {
    max-width: 760px;
    margin: 56px auto;
    padding: 0 32px;
    text-align: center;
  }
  .turn-lead {
    font-family: var(--ab-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ab-text);
    margin: 0 0 14px;
  }
  .turn-emphasis {
    font-family: var(--ab-serif);
    font-size: 30px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ab-accent);
    margin: 0;
  }

  /* ---------- Closing statement ---------- */
  .close {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 32px 88px;
    font-family: var(--ab-serif);
    font-size: 24px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.55;
    color: var(--ab-text);
    text-align: center;
  }

  /* ---------- Invitations ---------- */
  .invitations {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 32px 64px;
    text-align: center;
  }
  .row {
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
  }
  .invitation {
    display: block;
    flex: 1 1 240px;
    max-width: 280px;
    padding: 34px 38px;
    background: var(--ab-parchment);
    border: 1px solid rgba(79, 52, 34, 0.25);
    border-radius: 15px;
    text-decoration: none;
    transition: background 0.5s ease, border-color 0.5s ease;
    text-align: left;
  }
  .invitation:hover {
    background: var(--ab-parchment-2);
    border-color: var(--ab-accent);
  }
  .invitation:first-child {
    border-color: var(--ab-accent);
  }
  .invitation:first-child:hover {
    border-color: var(--ab-text);
  }
  .invitation-title {
    font-family: var(--ab-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--ab-text);
    margin-bottom: 8px;
  }
  .invitation-desc {
    font-family: var(--ab-sans);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(79, 52, 34, 0.7);
  }

  /* Below this the two columns get too tight for a comfortable measure,
     so the photo goes back above the paragraph. */
  @media (max-width: 880px) {
    .essay-open {
      grid-template-columns: 1fr;
      row-gap: 28px;
    }
    .portrait-float {
      grid-column: 1;
      grid-row: 1;
      width: 320px;
      max-width: 70%;
      justify-self: center;
    }
    .float-p {
      grid-column: 1;
      grid-row: 2;
      font-size: 20px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 88px;
    }
    .hero h1 {
      font-size: 44px;
    }
    .intro p {
      font-size: 22px;
    }
    .portrait-float {
      width: 220px;
      max-width: 60%;
    }
    .essay-open p {
      text-align: left;
    }
    .pull-quote p {
      font-size: 32px;
    }
  }
</style>
