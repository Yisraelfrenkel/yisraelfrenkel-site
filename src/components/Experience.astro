---
import { experience } from "../data/content.js";
---

<section class="experience">
  <div class="container">
    <div class="thread reveal measure">
      <p class="eyebrow">{experience.eyebrow}</p>
      <h2>{experience.heading}</h2>
    </div>
    <ul class="items">
      {experience.items.map((item) => (
        <li class="item reveal">{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-top: 0.6rem;
  }
  .items {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem 2rem;
    max-width: 48rem;
  }
  .item {
    position: relative;
    padding-left: 1.6rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--gold);
  }
</style>
