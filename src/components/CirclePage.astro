---
// The pages for the course abroad.
//   circle = one circle  -> that host's own page (/orhaisha/<slug>): she invites, Rav Frenkel teaches.
//                           Each host sends out her own link; it signs up for her circle only.
//   circle = null        -> the Rav's general page (/orhaisha/join): the course, then "Choose your circle".
// `variant` is "teaser" (preview video; the button reserves a place at the free first class) or
// "first-class" (the cohort's first class embedded, sent out after it; the button pays for Classes 2–6).
import { course, circles, testimonials } from '../data/circles.js';

const { circle = null, variant = 'teaser' } = Astro.props;
const general = !circle;
const firstClass = variant === 'first-class';
const { slug = 'join', place, region, host, photo, about, signupLink, payLink, online } = circle || {};
const ready = general ? circles.every((c) => c.ready) : circle.ready;
const homes = circles.filter((c) => !c.online);
// who holds the Zoom circle, named wherever a page mentions it
const zoomHost = circles.find((c) => c.online)?.host;
const coach = zoomHost || 'one of our trained coaches';
const firstName = (h) => h ? h.replace(/^(Mrs.?|Ms.?|Rebbetzin)s+/i, '').split(' ')[0] : null;
const homeNames = homes.map((c) => c.place).join(', ').replace(/, ([^,]*)$/, ' and $1');
const sub = firstClass ? '/first-class' : '';
const mainPage = `/orhaisha/join${sub}/`;

const signUp = general ? '#circles' : (firstClass ? payLink : signupLink) || '#price';
const cta = general ? 'Choose your circle' : firstClass ? 'Join Classes 2–6' : 'Reserve your place at the first class';
const hostFirst = host ? host.replace(/^(Mrs\.?|Ms\.?|Rebbetzin)\s+/i, '').split(' ')[0] : null;
const circleName = general ? null : online ? 'the Zoom circle' : `the ${place} circle`;
const title = `The Love You're Meant to Build · ${general ? 'Live on Zoom' : online ? 'Live on Zoom' : place} — Rav Yisrael Frenkel`;
const ogTitle = general ? `The Love You're Meant to Build · Rav Yisrael Frenkel` : online ? `The Love You're Meant to Build · Live on Zoom` : `The Love You're Meant to Build · ${place}`;
const description = general
  ? `A six-class Torah course for young women before and during shidduchim, taught live on Zoom by Rav Yisrael Frenkel, with circles in ${homeNames} and on Zoom.`
  : online
  ? `A six-class Torah course for young women before and during shidduchim, taught live on Zoom by Rav Yisrael Frenkel, with a circle on Zoom held by ${host || 'a trained coach'}.`
  : `A six-class Torah course for young women before and during shidduchim, taught live on Zoom by Rav Yisrael Frenkel, with a circle in ${place}${host ? ` held by ${host}` : ''}.`;
const url = `https://yisraelfrenkel.com/orhaisha/${slug}${firstClass ? '/first-class' : ''}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  {!ready && <meta name="robots" content="noindex">}
  <title>{title}</title>
  <link rel="canonical" href={url}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://yisraelfrenkel.com/orhaisha/assets/ketubah-floral.jpg">
  <meta property="og:url" content={url}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/orhaisha/styles.css">
  <link rel="stylesheet" href="/orhaisha/circle.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="wrap nav">
  <a class="wordmark" href="https://yisraelfrenkel.com" aria-label="Yisrael Frenkel home"><img src="/orhaisha/assets/yisrael-frenkel-wordmark.png" alt="Yisrael Frenkel"></a>
  <nav class="desktop-nav" aria-label="Main navigation"><a href="#classes">The classes</a><a href="#testimonials">Testimonials</a><a href="#how">How it works</a><a href="#price">Price</a>{general ? <a href="#circles">Choose your circle</a> : <a href="#circle">{hostFirst ? <>Meet {hostFirst}</> : 'Your circle'}</a>}</nav>
  <a class="btn small nav-cta" href={signUp}>{general ? 'Choose' : firstClass ? 'Join' : 'Reserve'}</a>
</div></header>

<main id="main">
<section class="hero"><div class="hero-glow"></div><div class="wrap hero-grid">
  <div class="hero-copy">
    {!general && (
      <a class="invite" href="#circle">
        <span class="invite-photo">{photo ? <img src={photo} alt="" /> : <span class="photo-dot" aria-hidden="true">{online ? 'Z' : place[0]}</span>}</span>
        <span class="invite-text"><small>An invitation from</small><strong>{host || <mark class="blank">her name</mark>}</strong><span>{online ? 'to the Zoom circle, wherever you are' : <>to her circle in {place}</>}</span></span>
      </a>
    )}
    <p class="kicker"><span lang="he" dir="rtl">אור האשה</span> · Or HaIsha · A course by Rav Yisrael Frenkel</p>
    <h1>The Love You're <em>Meant to Build</em></h1>
    <p class="tagline">It begins long before you start dating.</p>
    <p class="lead">How will I know if he is the right one? What if I say yes to the wrong person? It begins with understanding what you need and deserve in an intimate relationship.</p>
    <div class="actions">
      <a class="btn" href={signUp}>{cta}</a>
      {general ? <a class="btn ghost" href="#classes">See the six classes</a> : <a class="btn ghost" href="#circle">{hostFirst ? <>Meet {hostFirst}</> : 'Meet your circle'}</a>}
    </div>
    <div class="week" aria-label="How each week works">
      <div class="week-step">
        <span class="week-photo"><img src="/orhaisha/assets/rav-avatar.jpg" alt="" /></span>
        <span class="week-text"><small>Live on Zoom</small><strong>The class, with Rav Yisrael Frenkel</strong></span>
      </div>
      <div class="week-step">
        {general
          ? <span class="week-photos">{circles.map((c) => <span class="week-photo">{c.photo ? <img src={c.photo} alt="" /> : <span class="photo-dot">{c.place[0]}</span>}</span>)}</span>
          : <span class="week-photo">{photo ? <img src={photo} alt="" /> : <span class="photo-dot">{online ? 'Z' : place[0]}</span>}</span>}
        <span class="week-text"><small>{general ? 'Right after' : online ? 'Right after, on Zoom' : <>Right after, in {place}</>}</small><strong>{general ? <>A circle of women, near you or on Zoom</> : <>The circle, with {host || coach}</>}</strong></span>
      </div>
      <p class="week-why">A place to process, internalize and share what the class brings up, from a woman's perspective.</p>
    </div>
    {online && (
      <div class="nearby">
        <p class="nearby-q">Live near {homes.map((c) => c.place).join(' or ')}?</p>
        <p class="nearby-a">Hear the same class with a circle of women in person, and talk it through face to face.</p>
        <div class="nearby-links">{homes.map((c) => (
          <a href={`/orhaisha/${c.slug}${sub}/`}>
            <span class="week-photo">{c.photo ? <img src={c.photo} alt="" /> : <span class="photo-dot">{c.place[0]}</span>}</span>
            <span><strong>{c.place}</strong><small>led by {c.host || 'a local host'}</small></span>
            <i aria-hidden="true">→</i>
          </a>
        ))}</div>
      </div>
    )}
  </div>
  {firstClass
    ? <figure class="hero-art"><img src="/orhaisha/assets/ketubah-floral.jpg" alt="Ashkenazic ketubah in Aramaic, framed by pink and ivory flowers with green foliage and gold accents." width="1400" height="1980" fetchpriority="high"></figure>
    : <figure class="hero-video"><video src={`/orhaisha/assets/preview-${slug}.mp4`} poster="/orhaisha/assets/preview-poster-rav.jpg" controls playsinline preload="metadata" aria-label="A short preview of the course"></video><figcaption>A taste of the course, from the first three classes</figcaption></figure>}
</div></section>

{firstClass && (
<section class="video" id="video"><div class="wrap centered"><p class="kicker">The first class</p><h2>Watch the first class</h2><p class="section-lead">Begin with what the ketubah already promises you.</p>
  {course.firstClassYoutubeId
    ? <div class="video-frame" data-youtube-id={course.firstClassYoutubeId}><div class="video-poster"><img src="/orhaisha/assets/flyer.png" alt="The Love You're Meant to Build course flyer"><div class="video-shade"></div><div class="play" aria-hidden="true"></div></div></div>
    : <div class="video-frame video-blank"><mark class="blank">The recording of your first class goes here</mark></div>}
  <div class="handout"><p>Everything you hear him promise in the first class is written down. Take it with you.</p><a class="btn ghost" href="/orhaisha/assets/What-He-Promises-You.pdf" download>Download the handout · What He Promises You</a></div>
</div></section>
)}

<section class="stats"><div class="wrap">
  <div class="stats-grid facts" aria-label="The course at a glance">
    <div><strong>Six classes</strong><span>one a week, live on Zoom</span></div>
    <div><strong>The first class is free</strong><span>come and see if it is for you</span></div>
    <div><strong>A circle of women</strong><span>{general ? 'near you or on Zoom, after each class' : online ? 'on Zoom, right after each class' : <>in {place}, right after each class</>}</span></div>
  </div>
  <p class="stats-line">After more than twenty years of working with couples and with young men and women: six classes to help young women make the right choice, and avoid the pain I have seen over the years.</p></div></section>


<section class="recognition"><div class="wrap narrow"><p class="kicker gold">The whole purpose of the ketubah</p><h2>A good wife is built on <em>what she is given.</em></h2>
  <p>Women are encouraged to be good wives: to be kind and giving, to build their husband, to make a home. All of this is true.</p>
  <p>And her ability to do it completely depends on receiving from her husband what she needs and deserves in a marriage. That is the entire purpose of the ketubah.</p>
  <p>It is very hard to bring that to life until you understand what the ketubah is teaching you. With that understanding, you are empowered to build a beautiful marriage.</p>
  <p class="pull-line">A young woman who knows what she deserves will never again confuse being wanted with being used.</p>
</div></section>

<section class="classes" id="classes"><div class="wrap"><div class="centered intro"><h2>Six classes. One whole picture.</h2></div>
  <div class="class-list">
    <details open><summary><span class="class-no">01</span><span><small>Knowing yourself</small><strong>What You Deserve</strong><i>“What am I even looking for?”</i></span></summary><ul><li>Listen to yourself: what you most need to feel from him. The ketubah, read out loud, promise by promise.</li><li>“You are mine” means “you are my responsibility.” Why the Torah puts that first.</li><li>Safety does not start with a husband. It started in your father's house, and it is not weakness.</li><li>What this tells you about men: a man becomes himself by providing, protecting, giving and loving. Your needs are what he was made for.</li></ul></details>
    <details><summary><span class="class-no">02</span><span><small>What you bring</small><strong>Why You Deserve It</strong><i>“Why should he do all that for me?”</i></span></summary><ul><li>The myths of marriage, and the truth: it is meant to be the most fulfilling thing a person does.</li><li>What you bring: the incredible value you bring to your husband. Your words, your respect, your beauty, your loyalty.</li><li>A woman stepping into her full self: giving from fullness, not sacrifice.</li><li>Sod HaYichud: whatever you need, he needs, inverted. Two halves, built for each other.</li></ul></details>
    <details><summary><span class="class-no">03</span><span><small>Intimacy</small><strong>The Expression of Oneness, Safety, and Love</strong><i>“How do I know his desire is safe?”</i></span></summary><ul><li>What physical intimacy is in a marriage: the expression of the oneness everything else is building toward.</li><li>The two faces of a man's desire in this world, and what the wrong one does to a woman who meets it.</li><li>The healing: the only things that belong in intimacy are the things that make you safe. Anything else has no place.</li><li>What to put on the table before engagement, touch during dating, and why attraction is a condition of marriage.</li></ul></details>
    <details><summary><span class="class-no">04</span><span><small>Dynamics</small><strong>What Makes or Breaks a Marriage</strong><i>“What actually destroys a marriage, and what repairs it?”</i></span></summary><ul><li>The Torah is a goal, not a test: you grow toward it, and every question is welcome.</li><li>“Do we have the same hashkafa?” A good marriage is not built on agreeing. It is built on how you disagree. Elu v'elu.</li><li>Respect, no war, then deciding together. Opinions are not needs, and your needs never disappear because of someone's opinion.</li><li>When he hurts you: from “No I didn't” to “I'm so sorry I hurt you,” and how a hurt can bring you closer.</li><li>What breaks the feeling of safety: her bashing, his anger, the silent treatment, and what to say instead.</li></ul></details>
    <details><summary><span class="class-no">05</span><span><small>Dating</small><strong>Dating and Building Friendship</strong><i>“What is dating actually for?”</i></span></summary><ul><li>Dating is not only discernment. It is how a relationship gets built, and how a man grows into it.</li><li>Having fun, and giving him opportunities to take care of you, and yourself opportunities to love him.</li><li>Having someone between you: when a middle person helps and when to go direct.</li><li>Long-term versus short-term dating, and what to check before you go out.</li></ul></details>
    <details><summary><span class="class-no">06</span><span><small>Deciding</small><strong>Choosing the Right One</strong><i>“Is this a yes, or is it fear talking?”</i></span></summary><ul><li>Red flags in dating: when something could be a problem, what to look for and how to notice it.</li><li>The things that come up while dating that mean: look deeper before you decide.</li><li>Everything on the table: how to talk to him about a red flag.</li><li>Settling versus being picky, and how to break up.</li></ul></details>
  </div>
</div></section>

<section class="voices" id="testimonials"><div class="wrap"><div class="centered intro"><p class="kicker">Testimonials</p><h2>In their words.</h2></div><div class="voices-grid">
  {testimonials.map((t) => (
    <figure class="voice">
      <blockquote>{t.text.map((p) => <p>{p}</p>)}</blockquote>
      <figcaption><strong>{t.name}</strong>{t.from && <> · {t.from}</>}</figcaption>
    </figure>
  ))}
  {testimonials.length < 2 && <figure><mark class="blank">A testimonial from a young woman</mark></figure>}
</div></div></section>

<section class="how" id="how"><div class="wrap"><div class="centered intro"><p class="kicker">How a class works</p><h2>Teaching, questions, then a room of your own.</h2></div><div class="how-grid">
  <article><b>60</b><h3>One hour</h3><p>{general ? 'Rav Frenkel teaches live on Zoom, on the screen in your circle.' : online ? 'Rav Frenkel teaches live on Zoom, on your screen at home.' : <>Rav Frenkel teaches live on Zoom, on the screen in {host ? <>{host}'s</> : <mark class="blank">her</mark>} home.</>} One class a week, six weeks.</p></article>
  <article><b>15</b><h3>Fifteen minutes</h3><p>Questions, anything you want to ask.</p></article>
  <article><b>30</b><h3>Thirty minutes in the circle</h3><p>{general ? <>Your circle's host holds the room: in a home in {homeNames}, or on Zoom.</> : online ? <>{host || coach} holds the circle on Zoom.</> : <>{host ? host : <mark class="blank">Her name</mark>} holds the room in {place}.</>} Time to talk through what came up. Join if you'd like; no one has to speak.</p></article>
  </div>
  <p class="schedule">{course.schedule ? course.schedule : <mark class="blank">Day, time and start date</mark>}</p>
  <p class="schedule-note">{general ? 'Every circle hears the same class at the same moment.' : 'The Zoom link is sent when you sign up.'}</p>
</div></section>

{general ? (
<section class="rooms" id="circles"><div class="wrap"><div class="centered intro"><p class="kicker">One course, {homes.length + 1} circles</p><h2>Choose your circle.</h2><p>The same class, at the same moment, in every circle. Choose the one closest to you; its host will welcome you and sign you up.</p></div>
  <div class="rooms-grid">
    {circles.map((c) => (
      <a class="room" href={`/orhaisha/${c.slug}${sub}/`}>
        <span class="room-photo">{c.photo ? <img src={c.photo} alt="" /> : <span class="photo-dot" aria-hidden="true">{c.online ? 'Z' : c.place[0]}</span>}</span>
        <small>{c.online ? 'On Zoom' : c.region}</small>
        <strong>{c.online ? 'From home' : c.place}</strong>
        <span class="room-host">{c.online ? <>With {c.host || 'one of our trained coaches'}, on Zoom</> : c.host ? <>In {c.host}'s home</> : <mark class="blank">Her name</mark>}</span>
        <span class="room-go">See this circle →</span>
      </a>
    ))}
  </div>
</div></section>
) : (
<section class="circle" id="circle"><div class="wrap circle-grid">
  <figure>{photo ? <img src={photo} alt={host || `The ${place} circle host`}> : <div class="photo-blank"><mark class="blank">Her photo</mark></div>}</figure>
  <div>
    <p class="kicker">{online ? <>Your circle · Zoom, from anywhere</> : <>Your circle · {place}, {region}</>}</p>
    <h2>{host ? <>{online ? 'The Zoom circle' : <>The {place} circle</>}, with {host}</> : <>{online ? 'The Zoom circle' : <>The {place} circle</>}, with <mark class="blank">her name</mark></>}</h2>
    {about ? [].concat(about).map((para) => <p>{para}</p>) : <p><mark class="blank">Two or three sentences about her, in her own words</mark></p>}
    <p>{online ? <>Each week, after Rav Frenkel's class and the questions, {hostFirst || 'she'} holds the circle on Zoom for the young women joining from home: thirty minutes in a warm room to reflect and talk through what came up.</> : <>Each week, after Rav Frenkel's class and the questions, {hostFirst || 'she'} holds the circle for the young women of {place}: thirty minutes in a warm room to reflect and talk through what came up.</>}</p>
    <a class="btn" href={signUp}>{cta}</a>
    {!online && <p class="circle-alt">Can't make it to {place}? The whole course is also live on Zoom, with {coach}. <a href={`/orhaisha/zoom${sub}/`}>Join on Zoom →</a></p>}
  </div>
</div></section>
)}

<section class="for"><div class="wrap for-grid"><div><p class="kicker">Who it is for</p><h2>Wherever you are on the way to the chuppah.</h2></div><ul><li>Young women before shidduchim, who want to walk in knowing what they are looking for.</li><li>Young women in shidduchim, who are being told to “just go out again” and want to know what they are looking at.</li><li>Young women who are engaged, and want the last stretch to the chuppah to be theirs.</li><li>Mothers: this is the course you wish someone had given you. Send it to her.</li></ul></div></section>

<section class="mothers" id="mothers"><div class="wrap"><div class="mothers-card">
  <p class="kicker">For mothers</p>
  <h2>Thinking of <em>your daughter?</em></h2>
  <p>Maybe there are things you wish someone had told you before your own wedding. Send her this page. The first class is free, and she can decide for herself if it is for her.</p>
  <a class="btn ghost" href={`https://wa.me/?text=${encodeURIComponent(`I thought of you when I saw this: The Love You're Meant to Build, a six-class course for young women with Rav Yisrael Frenkel. The first class is free. ${url}/`)}`} target="_blank" rel="noopener">Send it to her on WhatsApp</a>
</div></div></section>

<section class="price" id="price"><div class="wrap"><div class="centered intro"><p class="kicker">Six weeks</p><h2>Join the course.</h2></div><div class="price-grid">
  <article class={firstClass ? "" : "featured"}><small>The first class</small><div class="amount">Free</div><p>Come, listen, and see if it is for you.</p>{!firstClass && <a class="btn" href={signUp}>{cta}</a>}{!general && !firstClass && !signupLink && <p class="blank-note"><mark class="blank">{online ? 'The Zoom sign-up form link goes on this button' : 'Her sign-up form link goes on this button'}</mark></p>}</article>
  <article class={firstClass ? "featured" : ""}><small>Classes 2–6 and {general ? 'your circle' : circleName}</small><div class="amount">{course.priceLate}</div><p>The price is {course.priceLate}.<br><strong>Early-bird special: {course.priceEarly} if you sign up within 24 hours of the first class.</strong></p>{firstClass && <a class="btn" href={signUp}>{cta}</a>}{!general && firstClass && !payLink && <p class="blank-note"><mark class="blank">{online ? 'The Zoom payment link goes on this button' : 'Her Stripe payment link goes on this button'}</mark></p>}{!firstClass && <p class="later-note">You join after the first class.</p>}</article>
  </div><p class="kind-note">If the price is the only thing keeping you away, write to me. No one is turned away.</p>
</div></section>

<section class="why"><div class="wrap why-grid"><figure class="why-photo"><img src="/orhaisha/assets/yisrael-why-smiling.jpg" alt="Rav Yisrael Frenkel, smiling"></figure><div><p class="kicker">Why I teach this</p><h2>The Torah teaches it in detail.</h2><p class="why-lead">For more than twenty years I have sat with couples, with chassanim, and with women carrying the pain of marriages that didn't work.</p><blockquote class="why-pull"><span>Not bad people. Not bad marriages.</span> Two people who were never shown how a husband and a wife actually fit together.</blockquote><p class="why-body">Most of what goes wrong was visible before the engagement. Not because anyone was hiding it, but because the young woman had never been taught what she was looking at, <em>or that she was allowed to need anything at all.</em></p><p class="why-body why-torah">It is in <span class="why-mark">the ketubah</span>, in <span class="why-mark">the words of kiddushin</span>, and in <span class="why-mark">halachos</span> that many chassanim and kallos never learn. <strong>I teach it to young women because it is theirs.</strong></p><p class="signature">— Rav Yisrael Frenkel</p><a class="text-link" href="https://yisraelfrenkel.com/about">About Rav Frenkel →</a></div></div></section>

<section class="faq"><div class="wrap narrow"><div class="centered"><p class="kicker">Questions</p><h2>Before you come</h2></div><div class="faq-list">
  <details><summary>Do I have to talk in the circle?</summary><p>No. Many just listen the first week. The circle is there for whoever wants it.</p></details>
  <details><summary>Is this a kallah class?</summary><p>No. A kallah class comes later and teaches halacha. This course comes before, and teaches what you need to know before you say yes to anyone.</p></details>
  <details><summary>Is anything personal asked of me?</summary><p>Nothing. You are never asked to share anything. Much of the course you will simply hear, and recognize.</p></details>
  {general
    ? <details><summary>Which circle should I choose?</summary><p>The one closest to you. If there is no circle near you, or you would rather learn from home, join the Zoom circle with {coach}. Every circle hears the same class at the same moment. <a href="#circles">Choose your circle →</a></p></details>
    : online
    ? <details><summary>Where does the Zoom circle meet?</summary><p>On Zoom, right after the class and the questions. The link is sent when you sign up. If you live near {homes.map((c) => c.place).join(' or ')}, you can join {homes.map((c, i) => <>{i ? ' or ' : ''}{firstName(c.host) ? <>{firstName(c.host)}'s circle in </> : 'the circle in '}<a href={`/orhaisha/${c.slug}${sub}/`}>{c.place}</a></>)}, in person.</p></details>
    : <details><summary>Where does the {place} circle meet?</summary><p>In {host ? <>{host}'s</> : 'her'} home in {place}. The address is sent when you sign up.</p></details>}
  {!general && !online && <details><summary>Can I join from home instead?</summary><p>Yes. The whole course is also live on Zoom, with {coach} holding the Zoom circle afterwards. <a href={`/orhaisha/zoom${sub}/`}>Join on Zoom →</a></p></details>}
</div></div></section>

