---
// One page for one circle abroad. `variant` is "teaser" (preview video; the
// button reserves a place at the free first class) or "first-class" (the
// cohort's first class embedded, sent out after it; the button pays for Classes 2–6).
import { course, circles } from '../data/circles.js';

const { circle, variant = 'teaser' } = Astro.props;
const firstClass = variant === 'first-class';
const { place, region, host, photo, about, signupLink, payLink, ready, online } = circle;
const homes = circles.filter((c) => !c.online);
const homeNames = homes.map((c) => c.place).join(', ').replace(/, ([^,]*)$/, ' and $1');
const sub = firstClass ? '/first-class' : '';

const signUp = (firstClass ? payLink : signupLink) || '#price';
const cta = firstClass ? 'Join Classes 2–6' : 'Reserve your place at the first class';
const hostFirst = host ? host.replace(/^(Mrs\.?|Ms\.?|Rebbetzin)\s+/i, '').split(' ')[0] : null;
const title = `The Love You're Meant to Build · ${online ? 'Live on Zoom' : place} — Rav Yisrael Frenkel`;
const description = online
  ? `A six-class Torah course for young women before and during shidduchim, taught live on Zoom by Rav Yisrael Frenkel, with circles in ${homeNames}.`
  : `A six-class Torah course for young women before and during shidduchim, taught live on Zoom by Rav Yisrael Frenkel, with a circle in ${place}.`;
const url = `https://yisraelfrenkel.com/orhaisha/${circle.slug}${firstClass ? '/first-class' : ''}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  {!ready && <meta name="robots" content="noindex">}
  <title>{title}</title>
  <link rel="canonical" href={url}>
  <meta property="og:title" content={online ? `The Love You're Meant to Build · Live on Zoom` : `The Love You're Meant to Build · ${place}`}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://yisraelfrenkel.com/orhaisha/assets/ketubah-floral.jpg">
  <meta property="og:url" content={url}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/orhaisha/styles.css">
  <link rel="stylesheet" href="/orhaisha/circle.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="wrap nav">
  <a class="wordmark" href="https://yisraelfrenkel.com" aria-label="Yisrael Frenkel home"><img src="/orhaisha/assets/yisrael-frenkel-wordmark.png" alt="Yisrael Frenkel"></a>
  <nav class="desktop-nav" aria-label="Main navigation"><a href="#classes">The classes</a><a href="#how">How it works</a><a href="#price">Price</a><a href="#circles">The circles</a></nav>
  <a class="btn small nav-cta" href={signUp}>{firstClass ? "Join" : "Reserve"}</a>
</div></header>

<main id="main">
<section class="hero"><div class="hero-glow"></div><div class="wrap hero-grid">
  <div class="hero-copy">
    <p class="kicker"><span lang="he" dir="rtl">אור האשה</span> · Or HaIsha · {online ? 'On Zoom, wherever you are' : <>The {place} circle</>}</p>
    <h1>The Love You're <em>Meant to Build</em></h1>
    <p class="tagline">It begins long before you start dating.</p>
    <p class="lead">How will I know if he is the right one? What if I say yes to the wrong person? It begins with understanding what you need and deserve in an intimate relationship.</p>
    <div class="actions"><a class="btn" href={signUp}>{cta}</a><a class="btn ghost" href={online ? '#how' : '#circle'}>{online ? 'How it works' : 'Meet your circle'}</a></div>
    <p class="contact-line">{online ? <>Taught live from Yerushalayim, on your screen at home. After each class, a breakout room with one of our trained coaches.</> : <>Taught live on Zoom from Yerushalayim, with a circle of young women in {place}.</>}</p>
  </div>
  {firstClass
    ? <figure class="hero-art"><img src="/orhaisha/assets/ketubah-floral.jpg" alt="Ashkenazic ketubah in Aramaic, framed by pink and ivory flowers with green foliage and gold accents." width="1400" height="1980" fetchpriority="high"></figure>
    : <figure class="hero-video"><video src={`/orhaisha/assets/preview-${circle.slug}.mp4`} poster="/orhaisha/assets/course-preview-poster.jpg" controls playsinline preload="metadata" aria-label="A one-minute preview of the course"></video><figcaption>A one-minute taste of the course</figcaption></figure>}
</div></section>

{firstClass && (
<section class="video" id="video"><div class="wrap centered"><p class="kicker">The first class</p><h2>Watch the first class</h2><p class="section-lead">Begin with what the ketubah already promises you.</p>
  {course.firstClassYoutubeId
    ? <div class="video-frame" data-youtube-id={course.firstClassYoutubeId}><div class="video-poster"><img src="/orhaisha/assets/flyer.png" alt="The Love You're Meant to Build course flyer"><div class="video-shade"></div><div class="play" aria-hidden="true"></div></div></div>
    : <div class="video-frame video-blank"><mark class="blank">The recording of your first class goes here</mark></div>}
  <div class="handout"><p>Everything you hear him promise in the first class is written down. Take it with you.</p><a class="btn ghost" href="/orhaisha/assets/What-He-Promises-You.pdf" download>Download the handout · What He Promises You</a></div>
</div></section>
)}

<section class="stats"><div class="wrap"><p class="stats-line">After more than twenty years of working with couples and with young men and women: six classes to help young women make the right choice, and avoid the pain I have seen over the years.</p></div></section>

<section class="journey"><div class="wrap narrow centered"><p class="kicker">From Yerushalayim to chutz la'aretz</p><h2>It began in Yerushalayim. <em>Now it comes to you.</em></h2>
  <p>This fall, The Love You're Meant to Build opened in person in Yerushalayim. Now the same six classes come to young women in chutz la'aretz: taught live by Rav Frenkel on Zoom, and held together by women in {homeNames} who open their homes to a circle, and, for everyone joining from home, one of our trained coaches holding a breakout room on Zoom.</p>
  <p class="journey-line">One course. {homes.length + 1} rooms. One group of young women learning it together.</p>
</div></section>

<section class="recognition"><div class="wrap narrow"><p class="kicker gold">The whole purpose of the ketubah</p><h2>A good wife is built on <em>what she is given.</em></h2>
  <p>Women are encouraged to be good wives: to be kind and giving, to build their husband, to make a home. All of this is true.</p>
  <p>And her ability to do it completely depends on receiving from her husband what she needs and deserves in a marriage. That is the entire purpose of the ketubah.</p>
  <p>It is very hard to bring that to life until you understand what the ketubah is teaching you. With that understanding, you are empowered to build a beautiful marriage.</p>
  <p class="pull-line">A young woman who knows what she deserves will never again confuse being wanted with being used.</p>
</div></section>

<section class="classes" id="classes"><div class="wrap"><div class="centered intro"><h2>Six classes. One whole picture.</h2></div>
  <div class="class-list">
    <details open><summary><span class="class-no">01</span><span><small>Knowing yourself</small><strong>What You Deserve</strong><i>“What am I even looking for?”</i></span></summary><ul><li>Listen to yourself: what you most need to feel from him. The ketubah, read out loud, promise by promise.</li><li>“You are mine” means “you are my responsibility.” Why the Torah puts that first.</li><li>Safety does not start with a husband. It started in your father's house, and it is not weakness.</li><li>What this tells you about men: a man becomes himself by providing, protecting, giving and loving. Your needs are what he was made for.</li></ul></details>
    <details><summary><span class="class-no">02</span><span><small>What you bring</small><strong>Why You Deserve It</strong><i>“Why should he do all that for me?”</i></span></summary><ul><li>The myths of marriage, and the truth: it is meant to be the most fulfilling thing a person does.</li><li>What you bring: the incredible value you bring to your husband. Your words, your respect, your beauty, your loyalty.</li><li>A woman stepping into her full self: giving from fullness, not sacrifice.</li><li>Sod HaYichud: whatever you need, he needs, inverted. Two halves, built for each other.</li></ul></details>
    <details><summary><span class="class-no">03</span><span><small>Intimacy</small><strong>The Expression of Oneness, Safety, and Love</strong><i>“How do I know his desire is safe?”</i></span></summary><ul><li>What physical intimacy is in a marriage: the expression of the oneness everything else is building toward.</li><li>The two faces of a man's desire in this world, and what the wrong one does to a woman who meets it.</li><li>The healing: the only things that belong in intimacy are the things that make you safe. Anything else has no place.</li><li>What to put on the table before engagement, touch during dating, and why attraction is a condition of marriage.</li></ul></details>
    <details><summary><span class="class-no">04</span><span><small>Dynamics</small><strong>What Makes or Breaks a Marriage</strong><i>“What actually destroys a marriage, and what repairs it?”</i></span></summary><ul><li>Male aggression and anger: friction you work out, versus fear, which is the answer.</li><li>Female character assassination: the same words that build a man can take him apart.</li><li>The silent treatment, and navigating differences of opinion and hashkafa.</li><li>When feelings were hurt: how to repair, on both sides.</li></ul></details>
    <details><summary><span class="class-no">05</span><span><small>Dating</small><strong>Dating and Building Friendship</strong><i>“What is dating actually for?”</i></span></summary><ul><li>Dating is not only discernment. It is how a relationship gets built, and how a man grows into it.</li><li>Having fun, and giving him opportunities to take care of you, and yourself opportunities to love him.</li><li>Having someone between you: when a middle person helps and when to go direct.</li><li>Long-term versus short-term dating, and what to check before you go out.</li></ul></details>
    <details><summary><span class="class-no">06</span><span><small>Deciding</small><strong>Choosing the Right One</strong><i>“Is this a yes, or is it fear talking?”</i></span></summary><ul><li>Red flags in dating: when something could be a problem, what to look for and how to notice it.</li><li>The things that come up while dating that mean: look deeper before you decide.</li><li>Everything on the table: how to talk to him about a red flag.</li><li>Settling versus being picky, and how to break up.</li></ul></details>
  </div>
</div></section>

<section class="voices"><div class="wrap"><div class="centered intro"><p class="kicker">From the Yerushalayim cohort</p><h2>In their words.</h2></div><div class="voices-grid">
  <figure><mark class="blank">A testimonial from a young woman in Yerushalayim</mark></figure>
  <figure><mark class="blank">A testimonial from a young woman in Yerushalayim</mark></figure>
  <figure><mark class="blank">A testimonial from a mother</mark></figure>
</div></div></section>

<section class="how" id="how"><div class="wrap"><div class="centered intro"><p class="kicker">How a class works</p><h2>Teaching, questions, then a room of your own.</h2></div><div class="how-grid">
  <article><b>60</b><h3>One hour</h3><p>{online ? 'Rav Frenkel teaches live on Zoom from Yerushalayim, on your screen at home.' : <>Rav Frenkel teaches live from Yerushalayim, on the screen in {host ? <>{host}'s</> : <mark class="blank">her</mark>} home.</>} One class a week, six weeks.</p></article><article><b>15</b><h3>Fifteen minutes</h3><p>Questions, anything you want to ask.</p></article><article><b>03</b><h3>{online ? 'Then the breakout room' : 'Then the circle'}</h3><p>{online ? <>A small breakout room on Zoom, held by one of our trained coaches.</> : <>{host ? host : <mark class="blank">Her name</mark>} holds the room in {place}.</>} Talk through what came up for as long as you want. Join if you'd like; no one has to speak.</p></article>
  </div>
  <p class="schedule">{course.schedule ? course.schedule : <mark class="blank">Day, time and start date</mark>}</p>
  <p class="schedule-note">The Zoom link is sent when you sign up.</p>
</div></section>

<section class="for"><div class="wrap for-grid"><div><p class="kicker">Who it is for</p><h2>You do not have to wait until you are sure.</h2></div><ul><li>Young women before shidduchim, who want to walk in knowing what they are looking for.</li><li>Young women in shidduchim, who are being told to “just go out again” and want to know what they are looking at.</li><li>Young women who are engaged, and want the last stretch to the chuppah to be theirs.</li><li>Mothers: this is the course you wish someone had given you. Send it to her.</li></ul></div></section>

<section class="price" id="price"><div class="wrap"><div class="centered intro"><p class="kicker">Six weeks</p><h2>Join the course.</h2></div><div class="price-grid">
  <article class={firstClass ? "" : "featured"}><small>The first class</small><div class="amount">Free</div><p>Come, listen, and see if it is for you.</p>{!firstClass && <a class="btn" href={signUp}>{cta}</a>}{!firstClass && !signupLink && <p class="blank-note"><mark class="blank">{online ? 'The Zoom sign-up form link goes on this button' : 'Her sign-up form link goes on this button'}</mark></p>}</article>
  <article class={firstClass ? "featured" : ""}><small>Classes 2–6 and {online ? 'the breakout room' : <>the {place} circle</>}</small><div class="amount">{course.priceEarly}</div><p>if you join the night of the first class<br><strong>{course.priceLate} afterward</strong></p>{firstClass && <a class="btn" href={signUp}>{cta}</a>}{firstClass && !payLink && <p class="blank-note"><mark class="blank">{online ? 'The Zoom payment link goes on this button' : 'Her Stripe payment link goes on this button'}</mark></p>}{!firstClass && <p class="later-note">You join after the first class.</p>}</article>
  </div><p class="kind-note">If the price is the only thing keeping you away, write to me. No one is turned away.</p>
</div></section>

<section class="why"><div class="wrap why-grid"><figure><img src="/orhaisha/assets/yisrael-aron-kodesh-collar.jpg" alt="Rav Yisrael Frenkel in front of the Aron Kodesh"></figure><div><p class="kicker">Why I teach this</p><h2>The Torah teaches it in detail.</h2><p>For more than twenty years I have sat with couples, with chassanim, and with women carrying the pain of marriages that didn't work. Not bad people. Not bad marriages. Two people who were never shown how a husband and a wife actually fit together.</p><p>Most of what goes wrong was visible before the engagement. Not because anyone was hiding it, but because the young woman had never been taught what she was looking at, or that she was allowed to need anything at all.</p><p>The Torah teaches it in detail. It is in the ketubah, in the words of kiddushin, in the halachos every chassan learns and no kallah is told. I teach it to young women because it is theirs.</p><p class="signature">— Rav Yisrael Frenkel</p><a class="text-link" href="https://yisraelfrenkel.com/about">About Rav Frenkel →</a></div></div></section>

<section class="faq"><div class="wrap narrow"><div class="centered"><p class="kicker">Questions</p><h2>Before you come</h2></div><div class="faq-list">
  <details><summary>Do I have to talk in the circle?</summary><p>No. Many just listen the first week. The circle is there for whoever wants it.</p></details>
  <details><summary>Is this a kallah class?</summary><p>No. A kallah class comes later and teaches halacha. This course comes before, and teaches what you need to know before you say yes to anyone.</p></details>
  <details><summary>Is anything personal asked of me?</summary><p>Nothing. You are never asked to share anything. Much of the course you will simply hear, and recognize.</p></details>
  {online
    ? <details><summary>Do I need to be in a circle?</summary><p>No. The whole course works from home on Zoom. If you live near {homeNames}, you can also join a circle there in person. <a href="#circles">See the circles →</a></p></details>
    : <details><summary>Where does the {place} circle meet?</summary><p>In {host ? <>{host}'s</> : 'her'} home in {place}. The address is sent when you sign up.</p></details>}
  {!online && <details><summary>Can I join from home instead?</summary><p>Yes. The whole course is also live on Zoom, with one of our trained coaches holding a breakout room afterwards. <a href={`/orhaisha/zoom${sub}/`}>Join on Zoom →</a></p></details>}
</div></div></section>

{!online && <section class="circle" id="circle"><div class="wrap circle-grid">
  <figure>{photo ? <img src={photo} alt={host || `The ${place} circle host`}> : <div class="photo-blank"><mark class="blank">Her photo</mark></div>}</figure>
  <div>
    <p class="kicker">Your circle · {place}, {region}</p>
    <h2>{host ? <>The {place} circle, with {host}</> : <>The {place} circle, with <mark class="blank">her name</mark></>}</h2>
    {about ? <p>{about}</p> : <p><mark class="blank">Two or three sentences about her, in her own words</mark></p>}
    <p>Each week, after Rav Frenkel's class and the questions, {hostFirst || 'she'} holds the circle for the young women of {place}: a warm room to talk through what came up, for as long as you want.</p>
    <a class="btn" href={signUp}>{cta}</a>
  </div>
</div></section>}

<section class="rooms" id="circles"><div class="wrap"><div class="centered intro"><p class="kicker">{online ? 'Or join a circle near you' : <>One course, {homes.length + 1} rooms</>}</p><h2>{online ? 'Prefer a room together?' : 'Learning it together.'}</h2><p>The same class, at the same moment, in every room.</p></div>
  <div class="rooms-grid">
    {circles.map((c) => (
      <a class:list={['room', { here: c.slug === circle.slug }]} href={`/orhaisha/${c.slug}${sub}/`}>
        <span class="room-photo">{c.photo ? <img src={c.photo} alt="" /> : <span class="photo-dot" aria-hidden="true">{c.online ? 'Z' : c.place[0]}</span>}</span>
        <small>{c.online ? 'On Zoom' : c.region}</small>
        <strong>{c.online ? 'From home' : c.place}</strong>
        <span class="room-host">{c.online ? <>Breakout room with one of our trained coaches</> : c.host ? <>In {c.host}'s home</> : <mark class="blank">Her name</mark>}</span>
        <span class="room-go">{c.slug === circle.slug ? 'You are here' : 'See this circle →'}</span>
      </a>
    ))}
  </div>
</div></section>

<section class="closing"><div class="wrap centered"><p class="kicker">{online ? 'Live on Zoom' : <>The {place} circle</>}</p><h2>The love you're meant to build starts here.</h2><a class="btn light" href={signUp}>{cta}</a><p class="contact-line">Questions? <a href="https://wa.me/972587613153">WhatsApp</a> or <a href="mailto:Yisrael@YisraelFrenkel.com">email</a> Rav Frenkel.</p></div></section>
</main>

<footer><div class="wrap footer-grid"><div><img src="/orhaisha/assets/yisrael-frenkel-wordmark.png" alt="Yisrael Frenkel"><p>© 2026 Yisrael Frenkel<br>The Love You're Meant to Build</p></div><nav><a href="https://yisraelfrenkel.com">YisraelFrenkel.com</a><a href="https://yisraelfrenkel.com/about">About</a><a href="mailto:Yisrael@YisraelFrenkel.com">Email</a><a href="tel:+972587613153">+972-58-761-3153</a></nav><p class="credit">{online ? <>Live on Zoom from Yerushalayim, wherever you are.</> : <>The {place} circle. The address is sent when you sign up.</>}</p></div></footer>
{firstClass && <script is:inline src="/orhaisha/script.js"></script>}
</body></html>
