---
import { chaburahInfo } from "../data/content.js";
---

<section class="chaburah-info">
  <div class="container">
    <div class="thread reveal measure">
      <p class="eyebrow">{chaburahInfo.eyebrow}</p>
      <h2>{chaburahInfo.heading}</h2>
      <div class="paragraphs">
        {chaburahInfo.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <p class="audience-note">{chaburahInfo.audienceNote}</p>
    </div>
  </div>
</section>

<style>
  .chaburah-info {
    background: var(--paper-dim);
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-top: 0.6rem;
  }
  .paragraphs {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .audience-note {
    margin-top: 1.5rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--gold);
  }
</style>
