---
import { journey } from "../data/content.js";
---

<section class="journey">
  <div class="container">
    <div class="thread measure">
      {journey.lines.map((line) => (
        <p class="reveal">{line}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .journey p {
    font-family: var(--font-body);
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .journey p + p {
    margin-top: 1.6rem;
  }
  @media (max-width: 640px) {
    .journey p {
      font-size: 1.15rem;
    }
  }
</style>
