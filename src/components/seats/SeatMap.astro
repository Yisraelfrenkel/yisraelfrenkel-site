---
import { grid, fixtures, placedBlocks, allSeats } from "../../data/seating.js";

export interface Props {
  /** "view" = read-only chart. "pick" = seats are clickable buttons. */
  mode?: "view" | "pick";
}
const { mode = "view" } = Astro.props;
---

<div class="room" data-mode={mode}>
  <div class="tallies">
    <span class="tally tally--men"><b>Men</b> <span data-tally="men">&nbsp;</span></span>
    <span class="tally tally--women"><b>Women</b> <span data-tally="women">&nbsp;</span></span>
  </div>

  <div class="plan-scroll">
    <div class="plan" style={`--cols:${grid.cols}; --rows:${grid.rows};`}>
      {fixtures.map((f) => (
        <div
          class={`fixture fixture--${f.kind}`}
          style={`grid-column:${f.col} / span ${f.cols}; grid-row:${f.row} / span ${f.rows};`}
        >
          <span>{f.label}</span>
        </div>
      ))}

      {placedBlocks.map((b) => (
        <div
          class={`tray tray--${b.section}`}
          style={`grid-column:${b.col} / span ${b.cols}; grid-row:${b.row} / span ${b.rows};`}
          aria-hidden="true"
        ></div>
      ))}

      {allSeats.map((seat) => (
        <button
          type="button"
          class="seat"
          data-seat={seat.id}
          data-section={seat.section}
          disabled={mode === "view"}
          style={`grid-column:${seat.col} / span ${seat.w}; grid-row:${seat.row};`}
          title={`${seat.section === "men" ? "Men" : "Women"} · seat ${seat.number} · ${seat.blockLabel}`}
        >
          <span class="seat-num">{seat.number}</span>
          <span class="seat-name" data-name></span>
        </button>
      ))}
    </div>
  </div>

  <p class="plan-note">
    <button type="button" class="zoom-toggle" data-zoom-toggle aria-pressed="false">
      Zoom in
    </button>
    <span class="zoom-hint">Whole room shown — zoom in to read the numbers</span>
  </p>
</div>

<style>
  .room {
    --men: #6b7a45;
    --men-fill: #eef3e6;
    --women: #8a6a9c;
    --women-fill: #f2ecf5;
    --taken: #ded5c4;
    --taken-ink: #7b7061;
    --mine: #a6822e;
  }

  /* ---- legend ---- */
  .tallies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.78rem;
    color: var(--ink-soft, #6b6055);
    font-variant-numeric: tabular-nums;
  }
  .tally {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tally b {
    color: var(--ink, #2b2420);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }
  .tally::before {
    content: "";
    width: 11px;
    height: 11px;
    border-radius: 2px;
    border: 1px solid;
  }
  .tally--men::before {
    background: var(--men);
    border-color: var(--men);
  }
  .tally--women::before {
    background: var(--women);
    border-color: var(--women);
  }

  /* ---- the room ---- */
  .plan-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line, rgba(43, 36, 32, 0.12));
    border-radius: 4px;
    background: #fdfaf2;
  }
  .plan {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), minmax(26px, auto));
    gap: 2px;
    padding: 12px;
    min-width: 900px;
  }

  /* On a phone the default is the whole room at a glance — a chart you have to
     swipe around is useless for deciding where to sit. "Zoom in" swaps to the
     full-size, scrollable plan. */
  @media (max-width: 939px) {
    .room:not([data-zoom]) .plan {
      min-width: 0;
      gap: 1px;
      padding: 6px;
      grid-template-rows: repeat(var(--rows), minmax(15px, auto));
    }
    .room:not([data-zoom]) .seat {
      min-height: 15px;
      padding: 0;
      border-radius: 2px;
    }
    .room:not([data-zoom]) .seat-num {
      font-size: 0.46rem;
    }
    .room:not([data-zoom]) .seat-name {
      display: none;
    }
    .room:not([data-zoom]) .fixture {
      font-size: 0.36rem;
      letter-spacing: 0;
    }
  }

  /* ---- seats ---- */
  .seat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 26px;
    padding: 2px 1px;
    border: 1px solid var(--men);
    border-radius: 3px;
    background: var(--men-fill);
    color: var(--ink, #2b2420);
    font-family: var(--font-ui, sans-serif);
    line-height: 1.1;
    cursor: default;
    overflow: hidden;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .seat[data-section="women"] {
    border-color: var(--women);
    background: var(--women-fill);
  }
  .seat-num {
    font-size: 0.74rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .seat-name {
    font-size: 0.55rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--taken-ink);
  }
  .seat-name:empty {
    display: none;
  }

  .seat[data-status="taken"] {
    background: var(--taken);
    border-color: #c3b69f;
    color: var(--taken-ink);
  }
  .seat[data-status="taken"] .seat-num {
    opacity: 0.65;
  }

  .room[data-mode="pick"] .seat:not([data-status="taken"]) {
    cursor: pointer;
  }
  .room[data-mode="pick"] .seat:not([data-status="taken"]):hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(43, 36, 32, 0.18);
  }
  .room[data-mode="pick"] .seat[data-status="taken"] {
    cursor: not-allowed;
  }
  .seat[aria-pressed="true"],
  .seat[aria-pressed="true"][data-section="women"] {
    background: var(--mine);
    border-color: #7d621f;
    color: #fff;
  }
  .seat[aria-pressed="true"] .seat-name {
    color: rgba(255, 255, 255, 0.85);
  }

  /* The faint tray each table sits on, so the groupings read at a glance
     even though the seats themselves carry the numbers. */
  .tray {
    margin: -3px;
    border: 1px solid rgba(43, 36, 32, 0.24);
    border-radius: 5px;
    background: rgba(43, 36, 32, 0.035);
    pointer-events: none;
  }

  /* ---- fixtures ---- */
  .fixture {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border: 1px dashed rgba(43, 36, 32, 0.3);
    border-radius: 3px;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-soft, #6b6055);
    background: repeating-linear-gradient(
      45deg,
      rgba(43, 36, 32, 0.035),
      rgba(43, 36, 32, 0.035) 4px,
      transparent 4px,
      transparent 8px
    );
  }
  .fixture--bima {
    background: rgba(166, 130, 46, 0.12);
    border: 1px solid var(--gold, #a6822e);
    color: var(--gold, #a6822e);
    font-weight: 600;
  }
  .fixture--shelf,
  .fixture--books {
    border-style: solid;
    background: rgba(43, 36, 32, 0.04);
  }
  .fixture--door-h,
  .fixture--door-v {
    border: none;
    background: none;
    font-size: 0.52rem;
  }
  .fixture--door-h {
    border-bottom: 2px solid var(--ink-soft, #6b6055);
    align-items: flex-end;
  }
  .fixture--door-v {
    border-right: 2px solid var(--ink-soft, #6b6055);
    justify-content: flex-end;
  }
  .fixture--door-v span {
    writing-mode: vertical-rl;
  }

  /* A side wall: one solid rule down the right edge of its column, so it sits
     flush against the seats it encloses. */
  .fixture--wall-v {
    border: none;
    background: none;
    border-right: 3px solid var(--ink-soft, #6b6055);
    justify-content: flex-end;
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft, #6b6055);
  }
  .fixture--wall-v span {
    writing-mode: vertical-rl;
  }

  /* The mechitza: a vertical double rule down the room. */
  .fixture--mechitza {
    border: none;
    background: none;
    border-left: 3px double var(--stone-deep, #b9a374);
    border-right: 3px double var(--stone-deep, #b9a374);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    color: var(--stone-deep, #b9a374);
    font-weight: 600;
  }
  .fixture--mechitza span {
    writing-mode: vertical-rl;
  }

  .plan-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin: 0.6rem 0 0;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.72rem;
    color: var(--ink-soft, #6b6055);
    text-align: center;
  }
  .zoom-toggle {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--gold, #a6822e);
    border-radius: 999px;
    background: none;
    color: var(--gold, #a6822e);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  @media (min-width: 940px) {
    .plan-note {
      display: none;
    }
  }
</style>

<script>
  for (const btn of document.querySelectorAll("[data-zoom-toggle]")) {
    const room = btn.closest(".room");
    const hint = room.querySelector(".zoom-hint");
    btn.addEventListener("click", () => {
      const zoomed = room.hasAttribute("data-zoom");
      if (zoomed) {
        room.removeAttribute("data-zoom");
      } else {
        room.setAttribute("data-zoom", "");
      }
      btn.setAttribute("aria-pressed", String(!zoomed));
      btn.textContent = zoomed ? "Zoom in" : "Fit to screen";
      hint.textContent = zoomed
        ? "Whole room shown — zoom in to read the numbers"
        : "Swipe the plan sideways to move around the room";
    });
  }
</script>
