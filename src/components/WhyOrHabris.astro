---
import { whyOrHabris } from "../data/content.js";
---

<section class="why">
  <div class="container">
    <div class="thread reveal measure">
      <p class="eyebrow">{whyOrHabris.eyebrow}</p>
      <h2>{whyOrHabris.heading}</h2>
      <div class="why-paragraphs">
        {whyOrHabris.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-top: 0.6rem;
  }
  .why-paragraphs {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
</style>
