---
import { startHero } from "../data/content.js";
---

<section class="start-hero">
  <div class="sun" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow reveal">{startHero.eyebrow}</p>
    <h1 class="reveal">
      {startHero.titleLines.map((line, i) => (
        <span class:list={["title-line", { main: i === 0 }]}>{line}</span>
      ))}
    </h1>
    <div class="welcome measure reveal">
      {startHero.welcome.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <a href="#free-class" class="btn btn-primary">{startHero.ctaLabel}</a>
  </div>
</section>

<style>
  .start-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(5rem, 12vw, 8rem);
    padding-bottom: clamp(4rem, 10vw, 6rem);
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 65%);
  }
  .sun {
    position: absolute;
    top: -18rem;
    left: 50%;
    transform: translateX(-50%);
    width: 46rem;
    height: 46rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 193, 112, 0.55) 0%,
      rgba(232, 193, 112, 0.18) 40%,
      rgba(232, 193, 112, 0) 70%
    );
    pointer-events: none;
  }
  .container {
    position: relative;
  }
  h1 {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .title-line {
    font-size: clamp(1.05rem, 2.3vw, 1.4rem);
    font-weight: 500;
    color: var(--ink-soft);
  }
  .title-line.main {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 600;
    color: var(--ink);
    max-width: 22ch;
  }
  .welcome {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .btn {
    margin-top: 2.25rem;
  }
</style>
