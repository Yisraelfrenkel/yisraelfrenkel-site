---
import { startHero } from "../data/content.js";
---

<section class="start-hero">
  <div class="sun" aria-hidden="true"></div>
  <div class="container">
    <h1 class="reveal">
      {startHero.titleLines.map((line, i) => (
        <span class:list={["title-line", { main: i === 0 }]}>{line}</span>
      ))}
    </h1>

    <div class="beats">
      {startHero.beats.map((beat, i) => (
        <>
          {beat.role === "discovery" ? (
            <div class="discovery-wrap">
              <div class="discovery-glow reveal" aria-hidden="true"></div>
              <p class:list={["beat", `beat-${beat.role}`, "reveal", { standalone: beat.standalone }]}>
                {beat.text}
              </p>
            </div>
          ) : (
            <p
              class:list={["beat", `beat-${beat.role}`, "reveal", { standalone: beat.standalone }]}
            >
              {beat.text}
            </p>
          )}
          {i === 0 && (
            <img
              src={startHero.photo}
              alt="Rav Yisrael Frenkel"
              class="hero-photo reveal"
            />
          )}
          {beat.role === "mystery" && i === 4 && (
            <svg class="emerging-path reveal" viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
              <path d="M5 45 Q 90 15 150 30 T 295 10" fill="none" stroke="var(--gold)" stroke-width="1.5" />
            </svg>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .start-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(5rem, 12vw, 8rem);
    padding-bottom: clamp(4rem, 12vw, 9rem);
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 65%);
  }
  .sun {
    position: absolute;
    top: -18rem;
    left: 50%;
    transform: translateX(-50%);
    width: 46rem;
    height: 46rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 193, 112, 0.55) 0%,
      rgba(232, 193, 112, 0.18) 40%,
      rgba(232, 193, 112, 0) 70%
    );
    pointer-events: none;
  }
  .container {
    position: relative;
  }
  h1 {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .title-line {
    font-size: clamp(1.05rem, 2.3vw, 1.4rem);
    font-weight: 500;
    color: var(--ink-soft);
  }
  .title-line.main {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 600;
    color: var(--ink);
    max-width: 22ch;
  }

  /* ---------------------------------------------------------------
     The beats — a staged unveiling, not a paragraph. Role drives
     size, weight, and how much silence surrounds it.
  ----------------------------------------------------------------- */
  .beats {
    margin-top: clamp(3rem, 8vw, 5rem);
    display: flex;
    flex-direction: column;
    max-width: 34rem;
  }
  .beat {
    font-family: var(--font-body);
    color: var(--ink);
    line-height: 1.6;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .beat:first-child {
    margin-top: 0;
  }
  .beat-trust {
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    color: var(--ink-soft);
  }
  .beat-setup {
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    color: var(--ink-soft);
    font-style: italic;
  }
  .beat-question {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 4.2vw, 2.3rem);
    line-height: 1.35;
    color: var(--ink);
  }
  /* The question recedes rather than being illustrated — a quiet
     darkening behind it, so the visitor is left alone with it. */
  .beat-question::before {
    content: "";
    position: absolute;
    inset: -3rem -2.5rem;
    background: radial-gradient(ellipse at center, rgba(43, 36, 32, 0.055) 0%, transparent 72%);
    border-radius: 3rem;
    z-index: -1;
  }
  .beat-mystery {
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    color: var(--ink-soft);
  }
  /* A path quietly emerging before the discovery arrives */
  .emerging-path {
    display: block;
    width: 100%;
    max-width: 14rem;
    height: 2.5rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    opacity: 0.6;
  }
  /* Wraps just the discovery line so the glow centers on it precisely */
  .discovery-wrap {
    position: relative;
    margin-top: clamp(4rem, 10vw, 7rem);
    margin-bottom: clamp(4rem, 10vw, 7rem);
  }
  .discovery-wrap + .beat {
    margin-top: 0;
  }
  .beat-discovery {
    margin-top: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 5.4vw, 3rem);
    line-height: 1.3;
    color: var(--gold);
  }
  /* The sun arrives here — a localized glow behind the climax line */
  .discovery-glow {
    position: absolute;
    width: 34rem;
    height: 34rem;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 193, 112, 0.4) 0%,
      rgba(232, 193, 112, 0.14) 45%,
      rgba(232, 193, 112, 0) 72%
    );
    pointer-events: none;
    z-index: -1;
  }
  .beat-hope {
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    color: var(--ink);
  }

  /* Standalone beats get room to sit alone on the screen — the pause */
  .beat.standalone {
    margin-top: clamp(4rem, 10vw, 7rem);
    margin-bottom: clamp(4rem, 10vw, 7rem);
  }
  .beat.standalone + .beat {
    margin-top: 0;
  }

  .hero-photo {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    object-fit: cover;
    object-position: center 30%;
    border: 1px solid var(--line);
    box-shadow: 0 16px 40px rgba(43, 36, 32, 0.14);
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
