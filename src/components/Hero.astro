---
import { site, hero } from "../data/content.js";
---

<section class="hero">
  <div class="container">
    <p class="eyebrow on-dusk">{hero.eyebrow}</p>
    <h1>
      {hero.headlineLines.map((line) => (
        <span class="headline-line">{line}</span>
      ))}
    </h1>
    <div class="hero-sub measure">
      {hero.sub.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div class="hero-ctas">
      <a href={site.signupUrl} class="btn btn-primary">{hero.primaryCtaLabel}</a>
      <a href={site.whatsappUrl} class="btn btn-ghost on-dusk">{hero.secondaryCtaLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: radial-gradient(120% 140% at 15% 0%, var(--dusk-soft) 0%, var(--dusk) 55%);
    color: var(--dusk-text);
    padding-top: clamp(5rem, 12vw, 8rem);
    padding-bottom: clamp(4.5rem, 10vw, 7rem);
  }
  .eyebrow.on-dusk {
    color: var(--gold-bright);
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    max-width: 26ch;
    margin-top: 1.1rem;
    color: var(--dusk-text);
  }
  .headline-line {
    display: block;
  }
  .hero-sub {
    font-family: var(--font-body);
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(233, 228, 216, 0.82);
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .btn-ghost.on-dusk {
    color: var(--dusk-text);
  }
</style>
