---
import { site, hero } from "../data/content.js";
---

<section class="hero">
  <div class="path-art" aria-hidden="true">
    <svg viewBox="0 0 800 300" preserveAspectRatio="none">
      <path d="M0 260 Q 200 180 400 220 T 800 160" fill="none" stroke="var(--gold-soft)" stroke-width="3"/>
      <circle cx="620" cy="70" r="46" fill="var(--gold-soft)" />
    </svg>
  </div>
  <div class="container">
    <p class="eyebrow reveal">{hero.eyebrow}</p>
    <h1 class="reveal">
      {hero.headlineLines.map((line) => (
        <span class="headline-line">{line}</span>
      ))}
    </h1>
    <div class="hero-ctas reveal">
      <a href={site.signupUrl} class="btn btn-primary">{hero.primaryCtaLabel}</a>
      <a href={site.whatsappUrl} class="btn btn-ghost">{hero.secondaryCtaLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 70%);
    padding-top: clamp(5rem, 12vw, 8rem);
    padding-bottom: clamp(4.5rem, 10vw, 7rem);
  }
  .path-art {
    position: absolute;
    inset: 0;
    opacity: 0.7;
  }
  .path-art svg {
    width: 100%;
    height: 100%;
  }
  .container {
    position: relative;
  }
  h1 {
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    max-width: 30ch;
    margin-top: 1.1rem;
  }
  .headline-line {
    display: block;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
</style>
