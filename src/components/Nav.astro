---
import { site, nav } from "../data/content.js";
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#" class="nav-name">{site.title}</a>
    <nav class="nav-links" aria-label="Primary">
      {nav.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href={site.signupUrl} class="btn btn-primary nav-cta">{nav.ctaLabel}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(243, 239, 230, 0.88);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .nav-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--ink);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  .nav-links a:not(.btn) {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .nav-links a:not(.btn):hover {
    color: var(--ink);
  }
  .nav-cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
  }
  @media (max-width: 640px) {
    .nav-links a:not(.btn, .nav-cta) {
      display: none;
    }
  }
</style>
