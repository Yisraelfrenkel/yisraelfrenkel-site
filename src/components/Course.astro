---
import { course } from "../data/content.js";
---

<section id="course" class="course">
  <div class="container">
    <div class="thread reveal measure">
      <p class="eyebrow">{course.eyebrow}</p>
      <div class="course-title">
        {course.logo && <img src={course.logo} alt="" class="course-logo" />}
        <h2>{course.name}</h2>
      </div>
      <p class="course-intro">{course.intro}</p>
    </div>

    <ol class="steps">
      {course.steps.map((step, i) => (
        <li class="step reveal">
          <span class="step-number">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .course {
    background: var(--paper-dim);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }
  .course-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .course-logo {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .course-intro {
    margin-top: 1.25rem;
    font-size: 1.08rem;
    color: var(--ink-soft);
  }
  .steps {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 44rem;
  }
  .step {
    display: flex;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .step-number {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--gold);
    flex-shrink: 0;
    padding-top: 0.15rem;
  }
  .step h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .step p {
    margin-top: 0.4rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
</style>
