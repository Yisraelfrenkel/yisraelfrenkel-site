---
import { bhdHero } from "../../data/content.js";
---

<section class="bhd-hero">
  <img class="wordmark" src={bhdHero.wordmark} alt="Yisrael Frenkel" />
  <h1>{bhdHero.title}</h1>
  <p class="subtitle">{bhdHero.subtitle}</p>
</section>

<style>
  .bhd-hero {
    max-width: 1300px;
    margin: 0 auto;
    padding: var(--bhd-hero-pad) 24px var(--bhd-section-pad);
    text-align: center;
  }
  .wordmark {
    max-width: 320px;
    width: 60%;
    height: auto;
    display: block;
    margin: 0 auto calc(var(--bhd-section-pad) * 0.6);
  }
  h1 {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-h1) * 1.15);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 20px;
    color: var(--bhd-text);
  }
  .subtitle {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-h2) * 1.35);
    font-style: italic;
    font-weight: 500;
    color: rgba(79, 52, 34, 0.55);
    line-height: 1.35;
    margin: 0;
  }
</style>
