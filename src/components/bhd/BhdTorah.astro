---
import {
  tikkunTransition,
  tikkunImage,
  torahNarrative,
  torahHebrewQuote,
  torahEnglishIntro,
  torahEnglishQuote,
  torahPosedQuestion,
  torahClosing,
  livingJourney,
} from "../../data/content.js";
---

<div class="bhd-tint-2">
  <section class="tikkun-transition">
    <p>{tikkunTransition}</p>
  </section>

  <section class="tikkun-image">
    <img src={tikkunImage} alt="Tikkun HaBris — Mevushat LaBrit" />
  </section>

  <section class="torah-narrative">
    {torahNarrative.map((p) => <p>{p}</p>)}
    <p class="hebrew-quote">“{torahHebrewQuote}”</p>
    <p>{torahEnglishIntro}</p>
    <p class="quote">“{torahEnglishQuote}”</p>
    <p class="posed-question">{torahPosedQuestion}</p>
    {torahClosing.map((p) => <p>{p}</p>)}
  </section>

  <section class="living-journey">
    <h2>{livingJourney.heading}</h2>
    {livingJourney.paragraphs.map((p) => <p>{p}</p>)}
  </section>
</div>

<style>
  .bhd-tint-2 {
    background: var(--bhd-parchment-2);
    width: 100%;
  }
  .tikkun-transition {
    max-width: 900px;
    margin: 0 auto;
    padding: calc(var(--bhd-hero-pad) * 0.5) 32px 0;
    text-align: center;
  }
  .tikkun-transition p {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-h1) * 0.85);
    font-style: italic;
    line-height: 1.3;
    color: var(--bhd-accent);
    margin: 0;
  }
  .tikkun-image {
    max-width: 1300px;
    margin: 0 auto;
    padding: var(--bhd-hero-pad) 24px 0;
    text-align: center;
  }
  .tikkun-image img {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .torah-narrative {
    max-width: 1300px;
    margin: 0 auto;
    padding: calc(var(--bhd-body) * var(--bhd-body-lh)) 24px 0;
    text-align: left;
  }
  .torah-narrative p {
    font-family: var(--bhd-sans);
    font-size: var(--bhd-body);
    line-height: var(--bhd-body-lh);
    margin: 0 0 var(--bhd-para-gap);
    color: var(--bhd-text);
  }
  .torah-narrative .hebrew-quote,
  .torah-narrative .quote {
    font-family: var(--bhd-serif);
    font-size: var(--bhd-quote);
    font-style: italic;
    line-height: 1.6;
    color: var(--bhd-accent);
    text-align: center;
  }
  .torah-narrative .posed-question {
    font-family: var(--bhd-serif);
    font-size: var(--bhd-h3);
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    color: var(--bhd-text);
  }
  .living-journey {
    max-width: 1300px;
    margin: 0 auto;
    padding: var(--bhd-section-pad) 24px calc(var(--bhd-body) * 2 * var(--bhd-body-lh));
    text-align: left;
  }
  .living-journey h2 {
    font-family: var(--bhd-serif);
    font-size: var(--bhd-h2);
    font-weight: 600;
    text-align: center;
    margin: 0 0 var(--bhd-section-pad);
    color: var(--bhd-text);
  }
  .living-journey p {
    font-family: var(--bhd-sans);
    font-size: var(--bhd-body);
    line-height: var(--bhd-body-lh);
    margin: 0 0 var(--bhd-para-gap);
    color: var(--bhd-text);
  }
  .living-journey p:last-child {
    margin-bottom: 0;
  }
</style>
