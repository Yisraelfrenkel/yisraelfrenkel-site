---
import { beginningLine, freeClassVideo, writtenVersion } from "../../data/content.js";
---

<section class="reveal-intro">
  <p>Over the years, I discovered the reason</p>
</section>

<section class="reveal-mid">
  <p class="desire-line">
    The very desire that has brought you all this<br />
    <strong>pain</strong>,<br />
    <strong>shame</strong>,<br />
    and <strong>dissatisfaction</strong>—
  </p>
  <p class="force-line">
    at its <em>core</em><br />
    is the very force trying to lead you towards <span class="big-1">everything your heart needs<br />
    to become your true,<br />
    <span class="big-2">beautiful, and holy self.</span></span>
  </p>
</section>

<section class="beginning">
  <p>{beginningLine}</p>
</section>

<section class="video-cta">
  <a href={freeClassVideo.href} class="video-link" target="_blank" rel="noopener noreferrer">
    <img src={freeClassVideo.thumbnail} alt="The Free Class" />
    <div class="play-overlay">
      <div class="play-button">
        <div class="play-triangle"></div>
      </div>
    </div>
  </a>

  <p class="written-option">
    <span class="written-prompt">{writtenVersion.prompt}</span>
    <a
      href={writtenVersion.href}
      class="written-link"
      data-written-version
      target="_blank"
      rel="noopener noreferrer"
    >{writtenVersion.label} &rarr;</a>
  </p>
</section>

<script define:vars={{ intentKey: writtenVersion.intentKey }}>
  // Remember that this visitor came for the written version. Tally's
  // post-submit redirect sends everyone to /watch, which reads this flag
  // and starts the download instead of just playing the class.
  document.querySelectorAll("[data-written-version]").forEach((link) => {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem(intentKey, "1");
      } catch (e) {
        /* private mode — they can still download from /watch manually */
      }
    });
  });
</script>

<style>
  .reveal-intro {
    max-width: 1300px;
    margin: 0 auto;
    padding: calc(var(--bhd-hero-pad) * 0.3) 24px calc(var(--bhd-section-pad) * 0.4);
    text-align: center;
  }
  .reveal-intro p {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-h1) * 0.6);
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    color: var(--bhd-text);
  }
  .reveal-mid {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 24px calc(var(--bhd-section-pad) * 0.4);
    text-align: center;
  }
  .desire-line {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-quote) * 1.5);
    line-height: 1.6;
    font-style: italic;
    font-weight: 400;
    color: rgba(79, 52, 34, 0.8);
    margin: 0 0 var(--bhd-para-gap);
  }
  .desire-line strong {
    font-weight: 600;
  }
  .force-line {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-h2) * 1.3);
    line-height: 1.4;
    font-weight: 500;
    color: var(--bhd-accent);
    margin: var(--bhd-para-gap) 0 10px;
  }
  .big-1 {
    font-size: 1.3em;
  }
  .big-2 {
    font-size: 1.6em;
  }
  .beginning {
    max-width: 1300px;
    margin: 0 auto;
    padding: calc(var(--bhd-section-pad) * 0.35) 24px calc(var(--bhd-hero-pad) * 0.15);
    text-align: center;
  }
  .beginning p {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-quote) * 1.5);
    line-height: 1.5;
    font-style: italic;
    color: var(--bhd-accent);
    margin: 0;
  }
  .video-cta {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 24px var(--bhd-hero-pad);
    text-align: center;
  }
  .video-link {
    display: block;
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    text-decoration: none;
    padding: 10px;
    background: var(--bhd-parchment-4);
    border-radius: 8px;
  }
  .video-link img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }
  .play-overlay {
    position: absolute;
    inset: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .play-button {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--bhd-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(79, 52, 34, 0.3);
  }
  .play-triangle {
    width: 0;
    height: 0;
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
    border-left: 22px solid white;
    margin-left: 6px;
  }
  .written-option {
    max-width: 560px;
    margin: 22px auto 0;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(79, 52, 34, 0.7);
  }
  .written-prompt {
    display: block;
    font-style: italic;
    margin-bottom: 4px;
  }
  .written-link {
    color: var(--bhd-accent);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(164, 112, 79, 0.4);
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .written-link:hover {
    color: var(--bhd-text);
    border-bottom-color: var(--bhd-text);
  }
</style>
