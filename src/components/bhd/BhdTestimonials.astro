---
import { site, courseCta, personalSessionCta, testimonials, videoTestimonials } from "../../data/content.js";
---

<section class="course-cta">
  <div class="cta-row">
    <a href={site.signupUrl} class="cta-link" target="_blank" rel="noopener noreferrer">
      {courseCta.label}
    </a>
    <a href={site.personalSessionUrl} class="cta-link" target="_blank" rel="noopener noreferrer">
      {personalSessionCta.label}
    </a>
  </div>
</section>

<section class="testimonials">
  <div class="eyebrow">Others who have walked this path</div>

  {testimonials.map((t) => (
    <blockquote>
      <p class="quote">“{t.quote}”</p>
      <p class="name">{t.name}</p>
    </blockquote>
  ))}

  <div class="video-row">
    {videoTestimonials.map((id) => (
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${id}`}
          title="Testimonial"
          allowfullscreen
        ></iframe>
      </div>
    ))}
  </div>
</section>

<style>
  .course-cta {
    max-width: 900px;
    margin: 0 auto;
    padding: calc(var(--bhd-body) * var(--bhd-body-lh)) 32px var(--bhd-hero-pad);
    text-align: center;
  }
  .cta-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cta-link {
    display: inline-block;
    padding: 17px 38px;
    background: var(--bhd-parchment);
    border: 1px solid var(--bhd-accent);
    color: var(--bhd-text);
    font-family: var(--bhd-sans);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.35s ease, border-color 0.35s ease;
  }
  .cta-link:hover {
    background: var(--bhd-parchment-2);
    border-color: var(--bhd-text);
  }
  .testimonials {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 32px var(--bhd-hero-pad);
  }
  .eyebrow {
    font-family: var(--bhd-sans);
    font-size: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(79, 52, 34, 0.7);
    text-align: center;
    margin-bottom: var(--bhd-section-pad);
  }
  blockquote {
    margin: var(--bhd-section-pad) auto 0;
    padding: 0;
    max-width: 62ch;
  }
  blockquote:first-of-type {
    margin-top: 0;
  }
  .quote {
    font-family: var(--bhd-serif);
    font-size: var(--bhd-quote);
    font-style: italic;
    line-height: 1.6;
    color: var(--bhd-accent);
    margin: 0 0 16px;
  }
  .name {
    font-family: var(--bhd-sans);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: rgba(79, 52, 34, 0.7);
    margin: 0;
  }
  .video-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin: var(--bhd-section-pad) 0 0;
  }
  .video-embed {
    flex: 1 1 260px;
    max-width: 320px;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 4px;
  }
</style>
