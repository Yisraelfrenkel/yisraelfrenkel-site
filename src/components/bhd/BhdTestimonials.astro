---
import { testimonials, videoTestimonials } from "../../data/content.js";
---

{/* The Join / Book buttons that used to sit here now live at the end of
    BhdJourney, which is the page's arrival point. Repeating them a few
    hundred pixels apart read as a duplicate. */}

<section class="testimonials">
  <div class="eyebrow">Others who have walked this path</div>

  {testimonials.map((t) => (
    <blockquote>
      <p class="quote">“{t.quote}”</p>
      <p class="name">{t.name}</p>
    </blockquote>
  ))}

  <div class="video-row">
    {videoTestimonials.map((id) => (
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${id}`}
          title="Testimonial"
          allowfullscreen
        ></iframe>
      </div>
    ))}
  </div>
</section>

<style>
  .testimonials {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--bhd-hero-pad) 32px var(--bhd-hero-pad);
  }
  .eyebrow {
    font-family: var(--bhd-sans);
    font-size: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(79, 52, 34, 0.7);
    text-align: center;
    margin-bottom: var(--bhd-section-pad);
  }
  blockquote {
    margin: var(--bhd-section-pad) auto 0;
    padding: 0;
    max-width: 62ch;
  }
  blockquote:first-of-type {
    margin-top: 0;
  }
  .quote {
    font-family: var(--bhd-serif);
    font-size: var(--bhd-quote);
    font-style: italic;
    line-height: 1.6;
    color: var(--bhd-accent);
    margin: 0 0 16px;
  }
  .name {
    font-family: var(--bhd-sans);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: rgba(79, 52, 34, 0.7);
    margin: 0;
  }
  .video-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin: var(--bhd-section-pad) 0 0;
  }
  .video-embed {
    flex: 1 1 260px;
    max-width: 320px;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 4px;
  }
</style>
