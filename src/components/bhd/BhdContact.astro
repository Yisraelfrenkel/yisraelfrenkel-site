---
import { site, contact } from "../../data/content.js";

const mailtoHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}`;
---

<section class="contact">
  <div class="eyebrow">{contact.label}</div>
  <div class="buttons">
    <a
      href={site.personalWhatsappUrl}
      class="btn"
      style={`border-color:${site.accentColor}; color:${site.accentColor}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      {contact.whatsappLabel}
    </a>
    <a
      href={mailtoHref}
      class="btn"
      style={`border-color:${site.accentColor}; color:${site.accentColor}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      {contact.emailLabel}
    </a>
  </div>
</section>

<style>
  .contact {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px var(--bhd-hero-space);
    text-align: center;
  }
  .eyebrow {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(48% 0.012 75);
    margin-bottom: 20px;
  }
  .buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border: 1px solid;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    background: transparent;
  }
</style>
