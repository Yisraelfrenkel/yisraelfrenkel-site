---
import { site, contact } from "../../data/content.js";

const mailtoHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}`;
---

<section class="contact">
  <div class="eyebrow">{contact.label}</div>
  <div class="buttons">
    <a href={site.personalWhatsappUrl} class="btn" target="_blank" rel="noopener noreferrer">
      {contact.whatsappLabel}
    </a>
    <a href={mailtoHref} class="btn" target="_blank" rel="noopener noreferrer">
      {contact.emailLabel}
    </a>
  </div>
</section>

<style>
  .contact {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px var(--bhd-hero-pad);
    text-align: center;
  }
  .eyebrow {
    font-family: var(--bhd-sans);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(79, 52, 34, 0.7);
    margin-bottom: 20px;
  }
  .buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: var(--bhd-parchment);
    border: 1px solid var(--bhd-accent);
    color: var(--bhd-text);
    font-family: var(--bhd-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.35s ease, border-color 0.35s ease;
  }
  .btn:hover {
    background: var(--bhd-parchment-2);
    border-color: var(--bhd-text);
  }
</style>
