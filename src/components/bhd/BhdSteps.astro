---
import { stepsIntro, steps } from "../../data/content.js";
---

<section class="steps-intro">
  {stepsIntro.map((line) => <p>{line}</p>)}
</section>

{steps.map((step, i) => (
  <section class="step" style={i === steps.length - 1 ? "padding-bottom: calc(var(--bhd-hero-pad) * 0.65);" : undefined}>
    <div class="eyebrow" style={`color:${step.color}`}>{step.title}</div>
    <img src={step.image} alt={step.title} />
    <div class="caption">
      {step.paragraphs.map((p) =>
        Array.isArray(p) ? (
          <p>
            {p.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>
        ) : (
          <p>{p}</p>
        )
      )}
    </div>
  </section>
))}

<style>
  .steps-intro {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px var(--bhd-section-pad);
    text-align: center;
  }
  .steps-intro p {
    font-family: var(--bhd-serif);
    font-size: calc(var(--bhd-h2) * 1.15);
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 var(--bhd-para-gap);
  }
  .steps-intro p:last-child {
    margin-bottom: 0;
  }

  .step {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 24px calc(var(--bhd-section-pad) * 1.5);
    text-align: center;
  }
  .eyebrow {
    font-family: var(--bhd-sans);
    font-size: calc(var(--bhd-body) * 1.2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .step img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }
  .caption {
    padding: 12px 0 0;
    text-align: center;
  }
  .caption p {
    font-family: var(--bhd-sans);
    font-size: calc(var(--bhd-body) * 1.2);
    line-height: var(--bhd-body-lh);
    margin: 0 0 var(--bhd-para-gap);
    color: var(--bhd-text);
  }
  .caption p:last-child {
    margin-bottom: 0;
  }
</style>
