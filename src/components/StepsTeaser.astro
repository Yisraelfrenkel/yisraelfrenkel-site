---
import { stepsTeaser } from "../data/content.js";

const icons = {
  Listen:
    '<path d="M12 3a5 5 0 0 0-5 5v4a5 5 0 0 0 10 0V8a5 5 0 0 0-5-5Z"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  Discern:
    '<path d="M12 3v3M12 6l-5 9a3 3 0 0 0 6 0Zm0 0l5 9a3 3 0 0 1-6 0M4 9h6M14 9h6"/>',
  Fulfill:
    '<path d="M12 20s-7-4.35-9.5-8.8C1 8 2.5 4.5 6 4.5c2 0 3.5 1.2 4 2.3.5-1.1 2-2.3 4-2.3 3.5 0 5 3.5 3.5 6.7C19 15.65 12 20 12 20Z"/>',
  Heal:
    '<path d="M12 21s-6.5-4.2-9-8.4C1.2 8.8 3 5 7 5c2 0 3.7 1.1 5 3 1.3-1.9 3-3 5-3 4 0 5.8 3.8 4 7.6-2.5 4.2-9 8.4-9 8.4Z"/><path d="M9 12h2l1-2 2 4 1-2h2"/>',
  Build:
    '<path d="M4 21V10l8-6 8 6v11"/><path d="M9 21v-6h6v6"/>',
};
---

<section class="steps-teaser">
  <div class="container">
    <p class="teaser-intro reveal measure">{stepsTeaser.intro}</p>

    <ol class="icons">
      {stepsTeaser.names.map((name, i) => (
        <li class="icon-item reveal">
          <span class="icon-circle">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[name]} />
          </span>
          <span class="icon-number">0{i + 1}</span>
          <span class="icon-name">{name}</span>
        </li>
      ))}
    </ol>

    <div class="teaser-cta">
      <a href="/or-habris" class="btn btn-primary">{stepsTeaser.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .steps-teaser {
    background: var(--paper-dim);
  }
  .teaser-intro {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 auto;
    text-align: center;
  }
  .icons {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
  }
  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }
  .icon-circle {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--gold);
    border: 1px solid var(--gold-soft);
  }
  .icon-number {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--gold);
    letter-spacing: 0.05em;
  }
  .icon-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
  }
  .teaser-cta {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }
  @media (max-width: 720px) {
    .icons {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 420px) {
    .icons {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
