---
import { stepsTeaser } from "../data/content.js";
---

<section class="gallery">
  {stepsTeaser.steps.map((step) => (
    <div class="panel reveal">
      <div class="container panel-inner">
        <h2>{step.title}</h2>
        <div class="frame">
          <span class="frame-label">Placeholder for: {step.artPlaceholder}</span>
        </div>
        <p class="caption">{step.caption}</p>
      </div>
    </div>
  ))}

  <div class="container gallery-cta">
    <a href="/or-habris" class="btn btn-primary">{stepsTeaser.ctaLabel}</a>
  </div>
</section>

<style>
  .gallery {
    background: var(--paper);
  }
  .panel {
    padding-top: clamp(4rem, 9vw, 6rem);
    padding-bottom: clamp(4rem, 9vw, 6rem);
  }
  .panel:nth-child(even) {
    background: var(--paper-dim);
  }
  .panel-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  h2 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    color: var(--ink);
  }
  .frame {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    width: 100%;
    max-width: 46rem;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    border: 1px dashed var(--line);
    background: var(--paper-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .frame-label {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
    max-width: 32rem;
    line-height: 1.6;
  }
  .caption {
    margin-top: clamp(1.5rem, 3.5vw, 2rem);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    color: var(--ink);
    max-width: 28ch;
  }
  .gallery-cta {
    padding-top: clamp(3rem, 7vw, 4.5rem);
    padding-bottom: clamp(4rem, 9vw, 6rem);
    display: flex;
    justify-content: center;
  }
</style>
