---
import { site, finalRegistration } from "../data/content.js";
---

<section id="signup" class="signup">
  <div class="container">
    <div class="reveal measure">
      <p class="eyebrow on-dusk">{finalRegistration.eyebrow}</p>
      <h2>{finalRegistration.heading}</h2>
      <p class="signup-body">{finalRegistration.body}</p>
      <div class="signup-ctas">
        <a href={site.signupUrl} class="btn btn-primary">{finalRegistration.primaryCtaLabel}</a>
        <a href={site.whatsappUrl} class="btn btn-ghost on-dusk">{finalRegistration.whatsappCtaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .signup {
    background: radial-gradient(120% 140% at 50% 0%, var(--dusk-soft) 0%, var(--dusk) 60%);
    color: var(--dusk-text);
  }
  .eyebrow.on-dusk {
    color: var(--gold-bright);
  }
  h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    margin-top: 0.6rem;
    color: var(--dusk-text);
  }
  .signup-body {
    margin-top: 1.25rem;
    font-size: 1.08rem;
    line-height: 1.65;
    color: rgba(243, 239, 224, 0.82);
  }
  .signup-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  .btn-ghost.on-dusk {
    color: var(--dusk-text);
  }
</style>
