---
import { question } from "../data/content.js";
---

<section class="question">
  <div class="container">
    <p class="question-text reveal">{question.text}</p>
  </div>
</section>

<style>
  .question {
    padding: clamp(6rem, 14vw, 10rem) 0;
  }
  .question-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.6rem, 4.2vw, 2.75rem);
    line-height: 1.35;
    max-width: 18ch;
    margin: 0 auto;
    text-align: center;
    color: var(--ink);
  }
</style>
