---
import { bridge } from "../data/content.js";
---

<section class="bridge">
  <div class="container">
    <p class="bridge-text reveal measure">{bridge.text}</p>
  </div>
</section>

<style>
  .bridge {
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }
  .bridge-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, 2.8vw, 1.6rem);
    line-height: 1.55;
    color: var(--ink);
    margin: 0 auto;
    text-align: center;
    max-width: 38ch;
  }
</style>
