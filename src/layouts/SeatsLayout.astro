---
/* A deliberately standalone shell. It shares no nav, footer, logo or copy
   with the practice site, and it is marked noindex — the seating pages are
   reachable only by someone holding the link. */
import { config } from "../data/seating.js";

export interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --paper: #faf5e9;
        --ink: #2b2420;
        --ink-soft: #6b6055;
        --line: rgba(43, 36, 32, 0.12);
        --gold: #a6822e;
        --gold-soft: rgba(166, 130, 46, 0.14);
        --stone-deep: #b9a374;
        --font-display: "Fraunces", "Iowan Old Style", serif;
        --font-ui: "Inter", -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-ui);
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 980px; margin: 0 auto; padding: 2rem 1rem 5rem; }
      .page-head { text-align: center; margin-bottom: 2rem; }
      .page-head h1 {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 5vw, 2.2rem);
        margin: 0 0 0.35rem;
        letter-spacing: -0.01em;
      }
      .page-head p { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
      .rule {
        width: 60px; height: 0; margin: 1rem auto 0;
        border-top: 2px solid var(--stone-deep);
      }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        gap: 0.5rem; padding: 0.85rem 1.6rem; border-radius: 999px;
        border: 1px solid var(--gold); background: var(--gold); color: #fff;
        font-family: var(--font-ui); font-size: 0.92rem; font-weight: 600;
        text-decoration: none; cursor: pointer;
      }
      .btn[disabled] { opacity: 0.45; cursor: not-allowed; }
      .btn--ghost { background: none; color: var(--gold); }
      .card {
        background: #fff; border: 1px solid var(--line);
        border-radius: 8px; padding: 1.25rem;
      }
      .muted { color: var(--ink-soft); font-size: 0.82rem; }
      label { display: block; font-size: 0.78rem; font-weight: 600; margin-bottom: 0.3rem; }
      input[type="text"], input[type="tel"], input[type="password"] {
        width: 100%; padding: 0.7rem 0.8rem; font: inherit; font-size: 0.95rem;
        border: 1px solid var(--line); border-radius: 5px; background: #fff;
        color: var(--ink);
      }
      .field { margin-bottom: 1rem; }
      .err { color: #a33; font-size: 0.82rem; margin: 0.5rem 0 0; }
      .ok { color: #4a6b2f; font-size: 0.82rem; margin: 0.5rem 0 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="page-head">
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
        <div class="rule"></div>
      </header>
      <slot />
      <footer style="margin-top:3rem;text-align:center" class="muted">
        Questions — <a href={config.contactWhatsapp} style="color:var(--gold)">{config.contactName}</a>
      </footer>
    </div>
  </body>
</html>
