---
import { site, contact } from "../data/content.js";

const mailtoHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}`;
---

<section id="contact" class="contact">
  <div class="container">
    <div class="reveal measure">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2>{contact.heading}</h2>
      <div class="contact-ctas">
        <a
          href={site.personalWhatsappUrl}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          {contact.whatsappLabel}
        </a>
        <a href={mailtoHref} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          {contact.emailLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin-top: 0.5rem;
  }
  .contact-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
