---
import { site, signup } from "../data/content.js";
---

<section id="signup" class="signup">
  <div class="container">
    <div class="reveal measure">
      <p class="eyebrow on-dusk">{signup.eyebrow}</p>
      <h2>{signup.heading}</h2>
      <div class="signup-body">
        {signup.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="signup-ctas">
        <a href={site.signupUrl} class="btn btn-primary">{signup.primaryCtaLabel}</a>
        <a href={site.whatsappUrl} class="btn btn-ghost on-dusk">{signup.whatsappCtaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .signup {
    background: var(--dusk);
    color: var(--dusk-text);
  }
  .eyebrow.on-dusk {
    color: var(--gold-bright);
  }
  h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    margin-top: 0.6rem;
    color: var(--dusk-text);
  }
  .signup-body {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-size: 1.08rem;
    color: rgba(233, 228, 216, 0.82);
  }
  .signup-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  .btn-ghost.on-dusk {
    color: var(--dusk-text);
  }
</style>
